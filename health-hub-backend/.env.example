# ===== Database (Neon) =====
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ===== Redis (Render Redis) =====
# External connection string from Render Redis, e.g. rediss://default:PASSWORD@HOST:PORT
REDIS_URL=

# ===== Auth =====
JWT_SECRET=change-me-to-a-random-64-char-string

# ===== CORS =====
# Comma-separated list of allowed frontend origins (e.g. https://your-app.vercel.app)
FRONTEND_URL=https://your-app.vercel.app

# ===== WhatsApp (optional — disabled by default) =====
WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# ===== Public Report URL (for WhatsApp share links) =====
# PUBLIC_REPORT_BASE_URL=https://your-app.vercel.app/report

# ===== Server =====
PORT=3000
NODE_ENV=production
