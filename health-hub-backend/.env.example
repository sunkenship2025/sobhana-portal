# =============================================================================
# Sobhana Health Hub — Backend Environment Configuration
# =============================================================================
# This file documents ALL environment variables. Copy it to .env for local dev.
#
# PRODUCTION  -> uses Neon main branch + Render prod service
# DEVELOPMENT -> uses Neon dev branch  + Render dev service (or local)
# =============================================================================

# ===== Database (Neon) =====
# Use the POOLER URL for DATABASE_URL (supports connection pooling).
# Use the DIRECT URL for DIRECT_DATABASE_URL (Prisma migrations, scripts).
#
# PROD (Neon main branch):
#   DATABASE_URL=postgresql://neondb_owner:****@ep-sparkling-shape-akguwfol-pooler.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#   DIRECT_DATABASE_URL=postgresql://neondb_owner:****@ep-sparkling-shape-akguwfol.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# DEV (Neon dev branch):
#   DATABASE_URL=postgresql://neondb_owner:****@ep-sweet-rain-akt1liwn-pooler.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#   DIRECT_DATABASE_URL=postgresql://neondb_owner:****@ep-sweet-rain-akt1liwn.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=
DIRECT_DATABASE_URL=

# ===== Redis (Upstash) =====
# Same Redis instance can be shared across dev & prod for solo development.
# If you want isolation later, create a second Upstash database.
REDIS_URL=

# ===== Auth =====
# Use the SAME secret across dev and prod so tokens are portable.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ===== CORS =====
# Comma-separated list of allowed frontend origins.
# Must include ALL Vercel domains (production + preview/dev).
#
# PROD example:
#   FRONTEND_URL=https://reports.sobhanaportal.com
#
# DEV example (include your dev Vercel preview domain + local):
#   FRONTEND_URL=https://sobhana-portal-dev.vercel.app,http://localhost:5173
FRONTEND_URL=

# ===== WhatsApp (optional — disabled by default) =====
WHATSAPP_ENABLED=false
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# ===== Public Report URL (for WhatsApp share links) =====
# PUBLIC_REPORT_BASE_URL=https://reports.sobhanaportal.com/report

# ===== Server =====
PORT=3000
NODE_ENV=production
