{
  "name": "health-hub-backend",
  "version": "1.0.1",
  "description": "Sobhana Health Hub - Diagnostic Center & Polyclinic Management Backend",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --exec 'ts-node --transpile-only' src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "seed:catalog": "tsx prisma/seed-full-catalog.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "pulse:check": "ts-node --transpile-only pulse-view.ts && ts-node --transpile-only pulse-judge.ts && ts-node --transpile-only pulse-deterministic.ts && ts-node --transpile-only pulse-frontend.ts && ts-node --transpile-only pulse-steps.ts && ts-node --transpile-only pulse-sql.ts",
    "pulse:view": "ts-node --transpile-only pulse-view.ts",
    "pulse:det": "ts-node --transpile-only pulse-deterministic.ts",
    "pulse:replay": "ts-node --transpile-only pulse-replay.ts",
    "pulse:bench": "ts-node --transpile-only pulse-adversarial.ts",
    "pulse:regress": "ts-node --transpile-only pulse-regression.ts",
    "pulse:calc": "ts-node --transpile-only pulse-calc.ts",
    "pulse:when-funded": "ts-node --transpile-only pulse-when-funded.ts",
    "pulse:chain": "ts-node --transpile-only pulse-chain.ts",
    "pulse:artifacts": "ts-node --transpile-only pulse-artifact-fit.ts",
    "automations:check": "tsx automations-check.ts",
    "voicerx:check": "tsx src/services/voiceRx/normalize.ts && tsx src/services/voiceRx/controlled.ts && tsx src/services/voiceRx/validator.ts && tsx src/services/voiceRx/resolver.check.ts",
    "seed:medications": "tsx prisma/seed-medications.ts",
    "ui:check": "tsx doctor-ui-check.ts",
    "voicerx:bench": "tsx voicerx-bench.ts",
    "voicerx:queue-check": "tsx voicerx-queue-check.ts"
  },
  "keywords": [
    "healthcare",
    "diagnostic-center",
    "polyclinic",
    "payout",
    "multi-branch"
  ],
  "author": "Sobhana Health Hub Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1040.0",
    "@prisma/client": "^5.7.0",
    "@sentry/node": "^10.51.0",
    "@types/puppeteer": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "pdf-lib": "^1.17.1",
    "pgsql-ast-parser": "^12.0.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^5.7.0",
    "puppeteer": "^24.37.4",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.3",
    "ua-parser-js": "^2.0.10",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
