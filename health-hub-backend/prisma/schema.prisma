// This is the Prisma schema for Sobhana Health Hub
// Phase-1: Multi-branch diagnostic center + polyclinic with integrated payout engine
//
// ARCHITECTURAL RULES (FROZEN):
// 1. Visit is the single anchor for all medical data (patient, branch, domain, status)
// 2. All branch-scoped data must include branchId with unique compound constraints
// 3. Patient is global; all identifiers go through PatientIdentifier (extensible)
// 4. Doctor access is explicit via ReferralDoctor_Visit table (not implicit referralDoctorId)
// 5. Finalized reports are immutable (enforced via ReportStatus enum + status checks)
// 6. All enums are explicit (not strings) to prevent silent inconsistencies
// 7. AuditLog is insert-only (no updates, no deletes) - append-only event stream
// 8. Payout derived per test order (not per visit total)
// 9. Message delivery via WhatsApp Cloud API (with opt-in consent tracking)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS (Explicit to prevent silent inconsistencies)
// ============================================================================

enum UserRole {
  staff
  doctor
  owner
  admin
  lab_incharge
  sales
}

enum VisitDomain {
  DIAGNOSTICS
  CLINIC
}

enum VisitStatus {
  DRAFT
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Distinguishes a normal collection from a money-out refund on the payment ledger.
enum TransactionType {
  PAYMENT
  REFUND
}

/// CANCEL = void an order with nothing paid on it (removed from the bill subtotal).
/// REFUND = return money already collected against an order (full or partial).
enum OrderRefundKind {
  CANCEL
  REFUND
}

enum PaymentType {
  CASH
  ONLINE
  CHEQUE
}

enum BillDiscountType {
  FLAT_AMOUNT
  PERCENTAGE
}

enum ReportStatus {
  DRAFT //why??
  FINALIZED
}

enum DiagnosticWorkflowMode {
  REPORTABLE
  BILL_ONLY
  EXTERNAL_UPLOAD
  EVENT // ₹0 event-participation product; billing it mints a campaign coupon + sends its template instead of a bill/report
}

enum TestResultFlag {
  NORMAL
  HIGH
  LOW
  CRITICAL_HIGH
  CRITICAL_LOW
}

enum RangeCategory {
  MALE
  FEMALE
  INFANT
  CHILD
  OTHER
}

enum ClinicVisitType {
  OP // Outpatient
  IP // Inpatient
}

enum IdentifierType {
  PHONE
  EMAIL
  AADHAR
  OTHER
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  FINALIZE
  PAYOUT_DERIVE
  PAYOUT_PAID
  PAYOUT_DELETE
  REPORT_ACCESS
  /// Prescription signed — the irreversible transition. Distinct from FINALIZE,
  /// which reports use, because a signature carries a named human and a reg number.
  SIGN
  /// A signed prescription superseded by a new revision (with a reason).
  AMEND
  /// A doctor opened a patient outside their own care relationship (break-glass),
  /// with a stated reason. Rare by design; every row is meant to be read.
  BREAK_GLASS
}

enum Gender {
  M
  F
  O
}

enum Title {
  MR
  MRS
  MS
  MASTER
  BABY
}

enum PayoutDoctorType {
  REFERRAL
  CLINIC
  /// One two-sided payee replacing the old DIAGNOSTIC_CENTER + LAB split: a real
  /// partner is usually both directions at once, and settles on one net figure.
  PARTNER
}

enum ReferralSourceType {
  SELF // In-house test
  REFERRED_TO // We refer TO another diagnostic center
  REFERRED_FROM // Referred FROM another diagnostic center to us
}

/// The three deals we can have with a partner. Which one applies to an order is
/// DERIVED from the direction of the work — never chosen at the counter.
enum PartnerArrangementKind {
  INBOUND_BILLED_HERE // they send patients · we bill and collect · we owe them a cut
  INBOUND_BILLED_THERE // they send patients · THEY bill and collect · they owe us our share
  OUTBOUND_VENDOR // we send them work · we bill and collect · we owe them a vendor rate
}

/// What a partner rate is a rate OF. Set per rule, so one partner can hold a flat
/// per-test card on lab work and a percentage on imaging.
enum PartnerRateBasis {
  PCT_OF_OUR_PRICE // % of our list price for the test
  PCT_OF_PARTNER_BILLED // % of what the partner charged the patient
  FLAT // fixed amount per product, regardless of price
}

/// How a referring doctor is paid on partner-sourced work. NONE is the Lalitha
/// case: the partner IS the referrer, so no doctor is also paid.
enum PartnerDoctorCommissionMode {
  NONE
  OUR_SHARE // base = what we keep (default — can never exceed what we got)
  GROSS // base = the full price, as for a walk-in
}

enum ReferralPayoutType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageChannel {
  WHATSAPP
  SMS
}

enum MessageContextType {
  REPORT
  BILL
  REMINDER
  CAMPAIGN
  PAYMENT
  /// A signed prescription sent to the patient. The template MUST carry the
  /// prescriber's registration number — Telemedicine Practice Guidelines §3.2.5
  /// requires it on "prescriptions, website, electronic communication
  /// (WhatsApp/email etc.)", not only on the printed sheet.
  PRESCRIPTION
}

// E3-10: Panel layout types for report rendering
// Collapsed from 5 → 2 active + 2 future. CBP/WIDAL/INTERPRETATION_SINGLE are now
// STANDARD_TABLE with config flags (showSubgroups, showInterpretation, valueDisplayPrefix).
enum PanelLayoutType {
  STANDARD_TABLE // Configurable table: test | value | unit | reference
  TEXT_ONLY // Free-text result (peripheral smear, MP result)
  IMAGING_NARRATIVE // Future: radiology narrative reports
  PROCEDURE_STRUCTURED // Future: procedure-based structured reports
}

// ─── New Architecture Enums ──────────────────────────────────────
enum TestDefinitionStatus {
  ACTIVE
  LOCKED
  DEPRECATED
  ARCHIVED
}

enum InterpretationMode {
  NONE
  RANGE_BASED
  TEXT_MATCH
  FORMULA
}

enum ComparisonOperator {
  LT
  LTE
  GT
  GTE
  EQ
  BETWEEN
  MATCH
}

enum InterpretationRuleType {
  NUMERIC_RANGE
  TEXT_MATCH
  CATEGORY_MATCH
}

// Entry-time UI affordance for clinical tests (separate from clinical contract).
// NUMERIC: <input inputMode=decimal> (existing default behavior)
// FREE_TEXT: plain text input
// TEXT_WITH_PRESETS: combobox — preset list + free typing allowed
// SELECT_ONLY: dropdown locked to listed presets
enum TestInputType {
  NUMERIC
  FREE_TEXT
  TEXT_WITH_PRESETS
  SELECT_ONLY
}

// ============================================================================
// NUMBER SEQUENCE (For auto-generating P-00001, RD-00001, D-MPR-00001, etc.)
// ============================================================================

/// NumberSequence: Thread-safe counter for generating sequential numbers
/// Must be updated within database transaction to prevent race conditions
model NumberSequence {
  id        String   @id // e.g., "patient", "referralDoctor", "clinicDoctor", "diagnostic-MPR", "clinic-KPY"
  prefix    String // e.g., "P", "RD", "CD", "D-MPR", "C-KPY"
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([prefix])
}

// ============================================================================
// GLOBAL DATA (Not branch-scoped)
// ============================================================================

/// Patient is globally searchable and immutable once created.
/// All contact details go through PatientIdentifier for auditability.
model Patient {
  id            String    @id @default(cuid())
  patientNumber String    @unique // P-00001, P-00002, etc. (user-facing)
  name          String
  title         Title?
  yearOfBirth   Int // E2-09: Required - calculated from age or DOB
  dateOfBirth   DateTime? // E2-09: Optional - if user knows exact DOB
  ageUnit       String    @default("YEARS") // DAYS, MONTHS, YEARS — for smart age display
  gender        Gender
  address       String?
  /// Smart Reports: captured in billing only when a Smart-Report bundle is in the cart.
  /// Last recorded height, kept ONLY to prefill the billing form. The value a
  /// report renders comes from Visit.heightCm frozen into patientSnapshot.
  heightCm      Float?
  /// DEPRECATED — superseded by Visit.weightKg. Never read for a report: a single
  /// mutable weight made past reports' BMI change whenever the patient returned.
  weightKg      Float?
  createdAt     DateTime  @default(now())

  // WhatsApp consent — SERVICE messages only (reports, bills, OTP). Staff sending a
  // report may grant this; it has never implied consent to be marketed to.
  whatsappOptIn       Boolean   @default(false)
  whatsappOptInAt     DateTime?
  whatsappOptInSource String? // PATIENT_REGISTRATION_FORM, STAFF_MANUAL_SEND, POST_FINALIZE_AUTO

  /// MARKETING consent — offers and campaigns. Never granted implicitly. Opt-IN is per
  /// patient; opt-OUT is per phone number (see PhoneOptOut) because families share handsets.
  marketingOptIn       Boolean   @default(false)
  marketingOptInAt     DateTime?
  marketingOptInSource String? // COUNTER | INBOUND_START | IMPORT

  /// Set when the centre learns a patient has died. Suppresses EVERY automated send —
  /// not only marketing. A bill reminder to a widow is the same failure as an offer.
  deceasedAt       DateTime?
  deceasedByUserId String?

  /// Extensible identifiers (phone, email, Aadhar, etc.)
  identifiers PatientIdentifier[]

  /// All visits across all branches
  visits Visit[]

  /// Patient change history (identity field tracking)
  changeLogs PatientChangeLog[]

  /// Message delivery history
  messages MessageLog[]

  /// WhatsApp reply threads (patient messages inbox)
  conversations Conversation[]

  @@index([createdAt])
}

/// PatientIdentifier: Extensible identity model
/// Supports phone, email, Aadhar, and future identifier types.
/// Multiple identifiers per patient, one primary per type.
/// Note: Multiple patients can share the same identifier (e.g., family members with same phone)
model PatientIdentifier {
  id        String         @id @default(cuid())
  patientId String
  type      IdentifierType
  value     String
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([type, value])
}

/// ReferralDoctor: Registered doctors who refer patients (typically external practitioners)
/// Base commission % can be overridden per test.
model ReferralDoctor {
  id                      String             @id @default(cuid())
  doctorNumber            String             @unique // RD-00001, RD-00002, etc. (user-facing)
  name                    String
  phone                   String?
  email                   String?
  commissionType          ReferralPayoutType @default(PERCENTAGE)
  commissionPercent       Float              @default(50.0) // 0-100, can be overridden per test
  commissionAmountInPaise Int?
  clinicDoctorId          String? // Link if this person is also a clinic doctor
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  /// Referrals to visits (explicit access control)
  referrals ReferralDoctor_Visit[]

  /// Payout ledger
  payoutLedger  DoctorPayoutLedger[]
  productRules  ReferralDoctorProductRule[]
  categoryRules ReferralDoctorCategoryRule[]

  @@index([isActive])
  @@index([createdAt])
}

/// ReferralCategoryRate: centre-wide DEFAULT referral rate per payout category
/// (Laboratory, X-Ray, Ultrasound, ECG / Cardiology, CT / MRI). One row per
/// category. This is the base commission for a referred test — resolved from the
/// test's panel category — and replaces the old per-doctor flat default. A
/// per-doctor rate (ReferralDoctorCategoryRule) or per-product rule overrides it.
/// `category` stores the same free-text taxonomy as BillableProduct.payoutCategory
/// and payoutCategorize.ts, so referral rates and the payout statement share one
/// vocabulary. No FK — categories are centre-defined strings, not an enum.
model ReferralCategoryRate {
  id                      String             @id @default(cuid())
  /// null = global default (every branch inherits it); set = per-branch override.
  branchId                String?
  category                String
  commissionType          ReferralPayoutType @default(PERCENTAGE)
  commissionPercent       Float? // 0-100 when type = PERCENTAGE
  commissionAmountInPaise Int? // per-test flat payout when type = FIXED_AMOUNT
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Unique per (branch, category). Global (branchId = null) rows are kept unique
  // by the write path (find-then-write / delete-then-recreate), not the index.
  @@unique([branchId, category])
  @@index([isActive])
  @@index([branchId])
}

/// ReferralProductRate: centre-wide DEFAULT referral rate for ONE product — the
/// rung that was missing. Before this, a per-product rate could only be set per
/// doctor, so "nobody earns more than ₹300 on an MRI Brain" had to be entered 226
/// times. Sits BELOW both per-doctor rungs: a doctor rule is a deal struck with a
/// named person and outranks a centre default, per-product or not.
/// Resolution: doctor×product → doctor×category → CENTRE×product → CENTRE×category → ₹0
model ReferralProductRate {
  id        String  @id @default(cuid())
  /// null = global default (every branch inherits it); set = per-branch override.
  branchId  String?
  productId String

  commissionType          ReferralPayoutType @default(PERCENTAGE)
  commissionPercent       Float?
  commissionAmountInPaise Int?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch  Branch?         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product BillableProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([productId])
  @@index([branchId])
  @@index([isActive])
}

/// ReferralDoctorCategoryRule: per-doctor override of a category's referral rate.
/// Only set when a specific doctor negotiated a different rate for a modality
/// (e.g. "Dr X gets 35% on Lab"). Overrides ReferralCategoryRate; itself
/// overridden by a per-product rule or an ad-hoc bill override.
model ReferralDoctorCategoryRule {
  id                      String             @id @default(cuid())
  referralDoctorId        String
  /// null = this doctor's rate for every branch; set = per-branch override.
  branchId                String?
  category                String
  commissionType          ReferralPayoutType @default(PERCENTAGE)
  commissionPercent       Float?
  commissionAmountInPaise Int?
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  referralDoctor ReferralDoctor @relation(fields: [referralDoctorId], references: [id], onDelete: Cascade)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([referralDoctorId, branchId, category])
  @@index([referralDoctorId])
  @@index([branchId])
}

model ReferralDoctorProductRule {
  id                      String             @id @default(cuid())
  referralDoctorId        String
  /// null = this doctor's rate for every branch; set = per-branch override.
  branchId                String?
  productId               String
  commissionType          ReferralPayoutType @default(PERCENTAGE)
  commissionPercent       Float?
  commissionAmountInPaise Int?
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  referralDoctor ReferralDoctor  @relation(fields: [referralDoctorId], references: [id], onDelete: Cascade)
  product        BillableProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([referralDoctorId, branchId, productId])
  @@index([referralDoctorId])
  @@index([branchId])
  @@index([productId])
}

/// ClinicDoctor: In-house doctors (letterhead, registration, specialty)
/// Consultation fee commission can be percentage or fixed amount.
model ClinicDoctor {
  id                      String             @id @default(cuid())
  doctorNumber            String             @unique // CD-00001, CD-00002, etc. (user-facing)
  name                    String
  qualification           String // MBBS, MD (Gen Med), etc.
  specialty               String // General Medicine, Pediatrics, etc.
  registrationNumber      String             @unique
  phone                   String?
  email                   String?
  letterheadNote          String?
  /// What the doctor speaks when dictating: "te" (Telugu + English), "hi" (Hindi +
  /// English), "en", or null = let the recogniser detect. Each recogniser is told
  /// whatever reads that speech best (see asr.ts), not necessarily this code.
  dictationLanguage       String?
  /// The portal login this consulting doctor signs in as. Nullable: every existing
  /// ClinicDoctor predates doctor logins and stays valid without one. UNIQUE because
  /// one login must be exactly one doctor — a prescription signature has to be
  /// attributable to a single human, and a shared row would destroy that.
  userId                  String?            @unique
  /// Signature image (base64 data URI), captured through the SAME SignatureEditor +
  /// background-removal pipeline as SigningDoctor. Base64 rather than a path so it
  /// survives a Render deploy, matching SigningDoctor/SigningLabIncharge.
  signatureImageBase64    String?
  /// ABDM Healthcare Professionals Registry id. Optional and stays optional: HPR
  /// registration is voluntary, practice licensing runs through NMC/State Medical
  /// Councils, and most clinic doctors do not hold one. Never gate login on it.
  hprId                   String?
  roomLabel               String? // Optional room/cabin shown on the waiting-room display; blank = hidden
  consultationFeeInPaise  Int?
  commissionType          ReferralPayoutType @default(PERCENTAGE)
  commissionPercent       Float              @default(100.0) // 0-100, percentage of consultation fee
  commissionAmountInPaise Int? // Fixed amount per consultation (if commissionType = FIXED_AMOUNT)
  referralDoctorId        String? // Link if this person is also a referral doctor
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  /// Clinic visits (not referral-based)
  clinicVisits  ClinicVisit[]
  payoutLedger  DoctorPayoutLedger[]
  user          User?                @relation("ClinicDoctorLogin", fields: [userId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]

  @@index([isActive])
  @@index([createdAt])
}

/// LabTest: Diagnostic tests offered at the center
/// Price fixed globally, can be overridden per visit if needed.
model LabTest {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  priceInPaise  Int // Must be > 0, 0 for sub-tests
  referenceMin  Float?
  referenceMax  Float?
  referenceUnit String?
  referenceText String? // For text-based ranges like "Negative", "Non-reactive"
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0) // Order within parent panel
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Panel hierarchy: panels have children, sub-tests have parent
  parentTestId String? // NULL = standalone/panel, set = sub-test
  parentTest   LabTest?  @relation("TestHierarchy", fields: [parentTestId], references: [id])
  childTests   LabTest[] @relation("TestHierarchy")

  // Is this a panel (has children) or individual test?
  isPanel Boolean @default(false)

  // Extended fields for test management overhaul
  sampleType          String? // e.g., "Blood", "Serum", "Urine" — display on report
  method              String? // e.g., "ECLIA", "GOD-POD" — global default method
  departmentId        String? // Direct link to department for admin grouping
  defaultReferralType ReferralSourceType @default(SELF) // Default referral type, overridable at billing

  // Department relation
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// Test orders in visits
  testOrders TestOrder[]

  /// Test results (for sub-tests within panels)
  testResults TestResult[]

  // E3-10: Panel and interpretation relations
  panelItems      PanelTestItem[]
  interpretations InterpretationTemplate[]

  // Extended relations
  ageRanges        TestAgeRange[]
  derivedParameter DerivedParameter?

  @@index([isActive])
  @@index([code])
  @@index([createdAt])
  @@index([parentTestId])
  @@index([departmentId])
}

/// Branch: Physical location where visits occur
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // MPR, KPY, etc.
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Users with this as active branch
  users User[]

  /// All data for this branch
  visits                    Visit[]
  referrals                 ReferralDoctor_Visit[]
  partnerVisits             PartnerVisit[]
  partnerCategoryRules      PartnerCategoryRule[]
  partnerProductRules       PartnerProductRule[]
  referralProductRates      ReferralProductRate[]
  bills                     Bill[]
  payoutLedger              DoctorPayoutLedger[]
  auditLogs                 AuditLog[]
  productBranchPricing      ProductBranchPricing[]
  labInchargeRules          LabInchargeRule[]
  messageLogs               MessageLog[]
  conversations             Conversation[]
  displayScreens            DisplayScreen[]
  displayAds                DisplayAd[]
  prescriptions             Prescription[]

  /// Per-branch referral rate overrides (null-branch rows on these tables are the global defaults)
  referralCategoryRates       ReferralCategoryRate[]
  referralDoctorCategoryRules ReferralDoctorCategoryRule[]
  referralDoctorProductRules  ReferralDoctorProductRule[]

  @@index([isActive])
  @@index([code])
  @@index([createdAt])
}

/// DisplayScreen: a physical waiting-room TV paired to a branch.
/// Reached unauthenticated via /api/display/:code — the random code IS the credential.
model DisplayScreen {
  id          String    @id @default(cuid())
  branchId    String
  name        String // e.g. "Ground-floor OP"
  code        String    @unique // pairing/display token, random, lives in the TV URL
  scope       String    @default("OP") // OP | OP_IP (display filter; OP-only for now)
  doctorIds   String[]  @default([]) // which doctors show; empty = all with OP visits today
  holdSeconds Int       @default(18) // how long a "Now Serving" call holds before returning to ads
  showTrackQr Boolean   @default(true) // show the "track your token" QR on the ticker
  slug        String? // readable URL segment, unique per branch (e.g. "op" → /display/chintal/op)
  chimeSound  String    @default("dingdong") // call sound played on the TV: dingdong | none
  isActive    Boolean   @default(true)
  revokedAt   DateTime?
  lastSeenAt  DateTime? // refreshed while a TV holds the SSE stream open; online = within ~60s
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

/// DisplayAd: a promotional creative shown on the waiting-room display when idle.
/// kind IMAGE/VIDEO = one media object; SLIDESHOW = several images cycled.
/// Media lives in R2 (keys), streamed to the TV via the public display route.
model DisplayAd {
  id          String    @id @default(cuid())
  branchId    String
  name        String
  kind        String    @default("IMAGE") // IMAGE | VIDEO | SLIDESHOW
  mediaKeys   String[]  @default([]) // R2 keys; 1 for IMAGE/VIDEO, N (ordered) for SLIDESHOW
  mimeTypes   String[]  @default([]) // parallel to mediaKeys, for Content-Type on serve
  screenIds   String[]  @default([]) // which screens show this ad; empty = all screens in the branch
  fit         String    @default("cover") // cover (fill) | contain (letterbox)
  durationSec Int       @default(10) // IMAGE hold / SLIDESHOW per-slide; VIDEO plays to its end
  enabled     Boolean   @default(true)
  weight      Int       @default(1) // rotation frequency
  sortOrder   Int       @default(0)
  startDate   DateTime? // optional schedule window
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

/// User: Staff, doctor, owner
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String // bcrypt hash
  name           String
  phone          String?
  role           UserRole
  activeBranchId String
  isActive       Boolean  @default(true)
  /// Set when a member is invited to the portal; cleared the moment their sign-in
  /// details are sent, on the reply that opens WhatsApp's 24h service window.
  /// Non-null therefore means exactly "invited, hasn't replied yet".
  portalInviteAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activeBranch              Branch                 @relation(fields: [activeBranchId], references: [id], onDelete: Restrict)
  clinicDoctor              ClinicDoctor?          @relation("ClinicDoctorLogin")
  signedPrescriptions       Prescription[]         @relation("PrescriptionSignedBy")
  learnedMedications        Medication[]           @relation("MedicationLearnedBy")
  PaymentTransaction        PaymentTransaction[]
  ExternalReportUpload      ExternalReportUpload[]
  TestResultEntered         TestResult[]           @relation("TestResultEnteredBy")
  discountedBills           Bill[]                 @relation("BillDiscountedBy")
  refundedBills             Bill[]                 @relation("BillRefundedBy")
  orderRefunds              OrderRefund[]          @relation("OrderRefundCreatedBy")
  billDiscounts             BillDiscount[]         @relation("BillDiscountCreatedBy")
  noReportTestOrders        TestOrder[]            @relation("TestOrderNoReportBy")
  patientLinkDisabledVisits Visit[]                @relation("VisitPatientLinkDisabledBy")
  reopenedTestOrders        TestOrder[]            @relation("TestOrderReopenedBy")
  uploadInsteadTestOrders   TestOrder[]            @relation("TestOrderUploadInsteadBy")

  @@index([role])
  @@index([activeBranchId])
  @@index([isActive])
}

// Org-wide key/value settings that aren't branch-scoped. Currently holds the
// cloud-sync default for narrative/text reports (key `report_auto_sync_default`,
// value "true"/"false"), which the lab incharge can set "for all".
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================================
// BRANCH-SCOPED DATA (All anchored on Visit)
// ============================================================================

/// Visit: Single anchor for all medical data
/// All tests, results, bills, clinic data references this.
/// branchId + billNumber is unique per branch (auto-generated sequence).
/// NOTE: Visit.sourceVisitId is the clinic-visit → diagnostics link. Before it existed,
/// "did this consultation lead to tests?" was only answerable by a time window, which
/// counts unrelated walk-ins. See automations/predicates.ts for the asymmetric rule:
/// suppression stays generous (window), attribution is strict (this column, or a coupon).
model Visit {
  id                 String      @id @default(cuid())
  branchId           String
  patientId          String
  domain             VisitDomain // DIAGNOSTICS | CLINIC
  status             VisitStatus @default(DRAFT)
  billNumber         String // Format: D-{BRANCH_CODE}-{SEQ} or C-{BRANCH_CODE}-{SEQ}
  totalAmountInPaise Int // Sum of bill items
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Measured at billing when a Smart-Report package is billed. On the VISIT, not
  // the patient: weight changes between visits, and Patient.weightKg made a
  // FINALIZED report's BMI move every time the patient was re-weighed — the exact
  // mutation the frozen snapshots exist to prevent. Frozen into patientSnapshot at
  // finalize; Patient.heightCm survives only as a prefill convenience.
  heightCm Float?
  weightKg Float?

  /// The visit this one came out of. Set at diagnostics registration when the patient
  /// arrives from a consultation, so "did this consultation lead to tests?" stops being a
  /// guess. Scalar, not an FK: the automation module stays isolated from core visit FKs,
  /// and null means "we do not know", never "no".
  sourceVisitId String?

  // Set when the bill / finalized report is printed from the Finalized page.
  // Drives the green "Printed · time" affordance so staff can see at a glance
  // that a bill-only / films-only bill (or a finalized report) was already
  // printed. Purely a staff-facing signal; no bearing on report content.
  billPrintedAt   DateTime?
  reportPrintedAt DateTime?

  // Patient-facing online access kill switch for this visit. Set → every public
  // door (report link, bill QR gateway, bill PDF, patient app) answers "collect
  // at the centre" instead of serving the document, and the report/bill WhatsApp
  // sends are suppressed. Reversible; owner + lab_incharge only, reason
  // mandatory for lab_incharge. Deliberately NOT token revocation: a re-finalize
  // mints fresh tokens, and the patient app has no token to revoke.
  patientLinkDisabledAt       DateTime?
  patientLinkDisabledReason   String?
  patientLinkDisabledByUserId String?

  // Relations
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  patientLinkDisabledByUser User? @relation("VisitPatientLinkDisabledBy", fields: [patientLinkDisabledByUserId], references: [id], onDelete: SetNull)

  /// Explicit referrals (for diagnostics)
  referrals ReferralDoctor_Visit[]

  /// The partner this visit came from, if any (at most one — a visit has one source)
  partnerVisit PartnerVisit?

  /// Bill (one per visit)
  bill Bill?

  /// Diagnostics data (if domain = DIAGNOSTICS)
  testOrders TestOrder[]
  report     DiagnosticReport?

  /// External diagnostic report uploads (PDF) attached to this visit's EXTERNAL_UPLOAD test orders
  externalReportUploads ExternalReportUpload[]

  /// Clinic data (if domain = CLINIC)
  clinicVisit ClinicVisit?
  prescriptions Prescription[]

  /// Bill access tokens for WhatsApp bill PDF links
  billAccessTokens BillAccessToken[]

  /// Per-order cancel/refund records
  orderRefunds OrderRefund[]

  /// Per-grant concession records
  discounts BillDiscount[]

  @@unique([branchId, billNumber])
  @@index([branchId])
  @@index([patientId])
  @@index([domain])
  @@index([status])
  @@index([createdAt])
  @@index([patientId, createdAt])
  @@index([sourceVisitId])
}

/// Referral: Explicit doctor access control
/// Links referral doctor to visit (many-to-one for future multi-referral support).
/// MUST exist for doctor to see visit.
model ReferralDoctor_Visit {
  id               String    @id @default(cuid())
  visitId          String
  referralDoctorId String
  branchId         String
  createdAt        DateTime  @default(now())
  // Soft delete: when a visit is converted to SELF (or re-referred), the old
  // link is kept for history and marked here instead of being deleted. Every
  // referral-attribution read filters `deletedAt IS NULL`, so the visit looks
  // Self on the UI, in payouts, and on the doctors dashboard.
  deletedAt        DateTime?
  deletedReason    String?
  deletedBy        String? // userId who converted it

  visit          Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  referralDoctor ReferralDoctor @relation(fields: [referralDoctorId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Uniqueness on (visitId, referralDoctorId) is enforced by a partial unique
  // index (WHERE deletedAt IS NULL) created in migration
  // 20260705000000_referral_visit_soft_delete, so a visit can be re-referred to
  // the same doctor after a link is soft-deleted. Prisma can't express partial
  // uniques, so the plain index below is for query performance only.
  @@index([visitId, referralDoctorId])
  @@index([referralDoctorId])
  @@index([branchId])
  @@index([deletedAt])
}

/// Bill: Single bill per visit (financial anchor)
model Bill {
  id                      String            @id @default(cuid())
  visitId                 String            @unique
  billNumber              String // Duplicated for direct queries; should match Visit.billNumber
  branchId                String
  totalAmountInPaise      Int
  discountType            BillDiscountType?
  discountPercentage      Float?
  discountAmountInPaise   Int               @default(0)
  discountReason          String?
  discountedByUserId      String? // User who authorized the discount (set when discountAmountInPaise > 0)
  // Campaign coupon redeemed on this bill — a SEPARATE line from the manual discount above.
  couponId                String? // Coupon.id redeemed here (scalar link; module kept isolated from core billing FKs)
  couponCode              String? // snapshot of the code for the printed / WhatsApp bill line
  couponDiscountInPaise   Int               @default(0) // net = total - discountAmountInPaise - couponDiscountInPaise
  /// When a coupon and a counter concession both applied, the LARGER in rupees wins and
  /// the loser is recorded here rather than silently dropped — so the payout statement
  /// and the audit feed can both explain this bill later.
  rejectedDiscountInPaise Int               @default(0)
  rejectedDiscountReason  String?
  paidAmountInPaise       Int               @default(0)
  billedAt                DateTime          @default(now()) // Explicit billing timestamp; remains stable after payment updates
  paymentStatus           PaymentStatus     @default(PENDING)
  refundReason            String? // Latest refund reason (bill-level rollup; per-order reasons live on OrderRefund)
  refundedAt              DateTime? // When the most recent refund was processed; null until a refund exists
  refundedAmountInPaise   Int               @default(0) // Sum of MONEY returned to the patient (drives refund status + stats)
  reversedChargeInPaise   Int               @default(0) // Sum of CHARGE voided off orders (reduces net owed; gross stays intact)
  refundedByUserId        String? // User who processed the most recent refund (audit; mirrors discountedByUserId)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  visit            Visit                @relation(fields: [visitId], references: [id], onDelete: Cascade)
  branch           Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  discountedByUser User?                @relation("BillDiscountedBy", fields: [discountedByUserId], references: [id], onDelete: SetNull)
  refundedByUser   User?                @relation("BillRefundedBy", fields: [refundedByUserId], references: [id], onDelete: SetNull)
  transactions     PaymentTransaction[]
  orderRefunds     OrderRefund[]
  discounts        BillDiscount[]

  @@unique([branchId, billNumber])
  @@index([billNumber])
  @@index([billedAt])
  @@index([paymentStatus])
  @@index([createdAt])
}

// ============================================================================
// Events & Coupons (reusable across future drives/events — see EVENTS_AND_COUPONS.md)
// ============================================================================

/// CouponCampaign: reusable config for one event-driven coupon programme.
/// A future drive/event = one new row + one EVENT BillableProduct pointing at it. No new code.
model CouponCampaign {
  id                 String           @id @default(cuid())
  code               String           @unique // e.g. BLOOD_DONATION_2026
  name               String // human label, e.g. "Blood Donation Camp 2026"
  discountType       BillDiscountType @default(PERCENTAGE)
  discountPercentage Float?           @default(50) // used when discountType = PERCENTAGE
  discountReason     String // shown on the bill's coupon line, e.g. "Blood donation drive"
  validityDays       Int              @default(30) // coupon expires this many days after issue
  scope              CouponScope      @default(TESTS_ONLY) // what the discount applies to
  whatsappTemplate   String // approved template sent on issue, e.g. "blood_donor_reward"
  landingTheme       String           @default("blood_donation") // selects the /c/:token page theme
  isActive           Boolean          @default(true)

  /// How much of this coupon the REFERRING DOCTOR shares, 0-100.
  ///   0   = the centre absorbs it (commission on the pre-coupon bill)
  ///  50   = split
  /// 100   = the doctor shares fully (commission on what was collected)
  /// One number, three behaviours; read by payoutService so the decision is explicit
  /// rather than an accident of which column the allocator happened to read.
  referrerSharePct Int @default(0)

  /// UNIQUE_PER_PATIENT mints at issue. SHARED_CODE (V2) mints at redemption.
  distribution String @default("UNIQUE_PER_PATIENT")

  /// Only the patient it was issued to may redeem it. Default OFF: families share a
  /// phone here and someone collecting for a relative is normal.
  bindToPatient Boolean @default(false)

  /// Liability caps. Budget is counted at REDEMPTION (committed) plus everything live
  /// and unexpired (reserved) — counting only redemptions lets you issue 3x the budget
  /// and discover it when redemption catches up.
  maxRedemptions            Int?
  maxDiscountBudgetInPaise  Int?
  maxDiscountPerBillInPaise Int?
  reservedInPaise           Int      @default(0)
  committedInPaise          Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  products BillableProduct[]
  coupons  Coupon[]

  @@index([code])
  @@index([isActive])
}

/// Coupon: a single, one-time-use discount code tied to a campaign.
/// Minted when an EVENT product is billed; rendered on the public /c/:token page;
/// redeemed once from a diagnostic/clinic bill.
model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique // patient-facing, e.g. BLOOD-4K9X2
  token             String       @unique // SHA-256 of the public /c/:token link (raw bearer never stored)
  campaignId        String
  status            CouponStatus @default(ISSUED)
  patientId         String? // scalar link — kept isolated from core FKs
  phone             String? // recipient phone snapshot at issue
  issuedVisitId     String? // the ₹0 EVENT visit that minted it
  issuedByUserId    String?
  expiresAt         DateTime
  redeemedAt        DateTime?
  redeemedVisitId   String? // visit whose bill consumed it
  redeemedBillId    String?
  redeemedByUserId  String?
  note              String? // free-text staff comment / audit note
  allowedProductIds String[]     @default([]) // BillableProduct ids this coupon discounts; [] = all in-scope tests (campaign scope)
  /// Automation attribution. (automationRunId, automationStep) carries a partial UNIQUE
  /// index so a replayed step returns this coupon instead of minting a second one
  /// against the same budget.
  automationRunId   String?
  automationStep    Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  campaign CouponCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([status])
  @@index([patientId])
  @@index([phone])
  @@index([expiresAt])
  @@index([automationRunId])
}

enum CouponStatus {
  /// Minted, budget reserved, message not yet confirmed sent. Swept back to VOID if the
  /// send fails, so a failed send never leaves a live code behind.
  PENDING
  ISSUED
  REDEEMED
  EXPIRED
  VOID
  /// The redeeming order was cancelled or refunded — the discount came back with it.
  REFUNDED
}

enum CouponScope {
  TESTS_ONLY // discount applies to diagnostic test line items only
  WHOLE_BILL // discount applies to the entire bill (tests + consultation)
}

/// PaymentTransaction: Individual transaction ledger for a Bill
model PaymentTransaction {
  id                String          @id @default(cuid())
  billId            String
  amountInPaise     Int
  paymentType       PaymentType
  /// PAYMENT (collection) or REFUND (money out). computeBillFinancialsFromPersisted
  /// subtracts REFUND rows from paid, so due/status stay correct.
  transactionType   TransactionType @default(PAYMENT)
  transactionDate   DateTime        @default(now())
  referenceData     String? // Optional field for UPI reference, transaction ID, etc.
  collectedByUserId String // ID of the user who recorded this transaction
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  bill            Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  collectedByUser User @relation(fields: [collectedByUserId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@index([transactionDate])
  @@index([paymentType])
}

/// TestOrder: Individual test in a diagnostic visit
/// Supports per-test commission override snapshots for immutable payout derivation.
/// E3-03: Test metadata is snapshotted at order time for immutability.
/// DUAL FK: testId (old LabTest) + testDefinitionId (new TestDefinition) during migration.
model TestOrder {
  id                                      String                 @id @default(cuid())
  visitId                                 String
  testId                                  String
  branchId                                String
  workflowMode                            DiagnosticWorkflowMode @default(REPORTABLE)
  priceInPaise                            Int // Snapshot of test price at order time
  referralCommissionType                  ReferralPayoutType     @default(PERCENTAGE)
  referralCommissionPercentage            Float? // 0-100 when payout type = PERCENTAGE
  referralCommissionAmountInPaise         Int? // Fixed payout snapshot when payout type = FIXED_AMOUNT
  // ─── Partner money, frozen at order time ─────────────────────────────────
  // Replaces the old diagnosticCenterCommission* (they send in) and labCost*
  // (we send out) snapshot sets, which were the same idea modelled twice.
  // partnerId non-null ⇒ this order came from, or went to, a partner.
  //
  // ourShareInPaise is the ONE number every money surface reads as "what we get";
  // partnerCutInPaise is what we owe them. Exactly one is non-zero per
  // arrangement — when they collect we are owed our share and owe nothing back;
  // when we collect we keep the remainder and owe them their cut. Both are
  // already distributed across panel leaves, so summing over a visit is correct.
  partnerId          String?
  partnerArrangement PartnerArrangementKind?
  ourShareBasis      PartnerRateBasis?
  ourSharePercent    Float?
  ourShareInPaise    Int?
  partnerCutInPaise  Int?
  displayOrder                            Int                    @default(0)
  createdAt                               DateTime               @default(now())

  // Cancel/refund (per-order). reversedChargeInPaise accumulates the charge voided
  // off this order (caps partial reversals at priceInPaise); cancelledAt is set once
  // the whole order is reversed. cancelReason mirrors the latest reason.
  cancelledAt           DateTime?
  cancelReason          String?
  reversedChargeInPaise Int       @default(0)

  // "No written report needed" (films only). Set when a REPORTABLE order is
  // closed because the patient declined the narrative report — money is
  // untouched (NOT a refund/cancel). The order is then excluded from the
  // report, the entry screen, and the finalize-completeness check, exactly like
  // a cancel. Reversible until the visit's report is finalized.
  noReportAt       DateTime?
  noReportReason   String?
  noReportByUserId String? // User who closed this order as film-only (audit; mirrors Bill.discountedByUserId)

  // Swapped out for another product (Patient 360 → Edit billed tests → Replace).
  // Set together with cancelledAt so every "live orders" filter drops it, but
  // kept distinct because a replacement is NOT a cancellation: no charge is
  // reversed, and the order must stay out of the bill-discount denominator
  // (its replacement carries that price now). The row and its entered results
  // survive — a swap used to hard-delete both.
  replacedAt       DateTime?

  // Last reversal of a "no report needed" close (audit trace surfaced in
  // Patient 360 + the owner audit feed). Cleared again if the order is
  // re-waived. A reopened order re-enters the report/entry workflow.
  reopenedAt       DateTime?
  reopenedByUserId String?

  // "Upload instead": set when a REPORTABLE narrative/text report is switched to
  // being fulfilled by an uploaded PDF (an outside radiologist's report) rather
  // than a typed one. The actual behavior comes from workflowMode flipping to
  // EXTERNAL_UPLOAD; these are audit-only trace fields that also distinguish a
  // SWITCHED order from one that was born EXTERNAL_UPLOAD. Cleared on toggle-back.
  uploadInsteadAt       DateTime?
  uploadInsteadByUserId String?

  // E3-03: Test metadata snapshot (frozen at order time)
  testNameSnapshot      String // Test name at time of order
  testCodeSnapshot      String // Test code at time of order
  referenceMinSnapshot  Float? // Reference min at time of order
  referenceMaxSnapshot  Float? // Reference max at time of order
  referenceUnitSnapshot String? // Reference unit at time of order

  // New architecture: dual FK for migration period
  testDefinitionId String? // New-arch FK (nullable during migration)
  productId        String? // Which BillableProduct was ordered

  // Panel + payout-category snapshot (frozen at order time). panelId is the
  // ClinicalPanel this leaf came from (audit/trace; no FK — panels are editable
  // and a leaf must survive panel edits). payoutCategorySnapshot is the resolved
  // referral/payout category (Laboratory, X-Ray, …) used to pick the commission
  // rate at billing time and to group the payout statement. Both null for legacy
  // orders and for bill-only/upload/event placeholders with no backing panel.
  panelId                String?
  payoutCategorySnapshot String?

  visit               Visit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  test                LabTest          @relation(fields: [testId], references: [id], onDelete: Restrict)
  testDefinition      TestDefinition?  @relation(fields: [testDefinitionId], references: [id], onDelete: Restrict)
  product             BillableProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  partner             Partner?         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  noReportByUser      User?            @relation("TestOrderNoReportBy", fields: [noReportByUserId], references: [id], onDelete: SetNull)
  reopenedByUser      User?            @relation("TestOrderReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  uploadInsteadByUser User?            @relation("TestOrderUploadInsteadBy", fields: [uploadInsteadByUserId], references: [id], onDelete: SetNull)

  /// Results for this test
  testResults TestResult[]

  /// External PDF uploads attached to this order (only for EXTERNAL_UPLOAD workflow)
  externalUploads ExternalReportUpload[]

  /// Cancel/refund records referencing this specific order
  orderRefunds OrderRefund[]

  @@index([visitId])
  @@index([testId])
  @@index([testDefinitionId])
  @@index([branchId])
  @@index([branchId, createdAt])
  @@index([workflowMode])
  @@index([partnerId])
}

/// OrderRefund: a per-order cancel or refund event (supports partial amounts).
/// Bill-level rollups (Bill.refundedAmountInPaise / paymentStatus) are derived
/// from these rows; the refund is also written to the PaymentTransaction ledger
/// as a REFUND row so due/paid math stays correct.
/// BillDiscount: one row per discount GRANT, mirroring OrderRefund for cancels.
///
/// Bill.discountAmountInPaise stays the authoritative CURRENT amount — it is
/// rescaled when the subtotal changes (add/remove a test under a percentage
/// discount), so this ledger does not sum to it and is not meant to. What it
/// records is the thing nothing recorded before: WHEN a concession was granted,
/// by whom, and why. Without that, a discount given at collection time was filed
/// under the bill's date, so the audit feed's Today view never showed it and the
/// day sheet's Discount column kept moving after the sheet was printed.
///
/// ponytail: grant log, not a running balance. If the two ever need to tie, the
/// rescale path has to post a compensating row rather than edit the bill field.
model BillDiscount {
  id            String            @id @default(cuid())
  billId        String
  visitId       String
  branchId      String
  stage         BillDiscountStage @default(AT_BILLING)
  amountInPaise Int // the INCREMENT granted by this event, not the running total
  discountType  BillDiscountType
  percentage    Float? // set only when this grant was expressed as a percentage
  reason        String // required at both grant sites
  createdByUserId String
  createdAt     DateTime          @default(now())

  bill      Bill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  visit     Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdBy User  @relation("BillDiscountCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@index([visitId])
  @@index([branchId, createdAt])
}

/// Where in the visit's life a concession was granted. ON_DUE is the one that
/// matters: the service is already delivered, so the concession buys nothing —
/// it is the shape a pocketed collection would take, and it must be visible.
enum BillDiscountStage {
  AT_BILLING
  ON_DUE
}

model OrderRefund {
  id                    String          @id @default(cuid())
  billId                String
  visitId               String
  testOrderId           String? // null for a bill-level refund not tied to one order
  branchId              String
  kind                  OrderRefundKind
  amountInPaise         Int             @default(0) // MONEY returned this event (0 for a pure CANCEL of an unpaid order)
  chargeReversedInPaise Int             @default(0) // CHARGE voided off the order this event
  reason                String // required (preset reason label)
  note                  String? // optional free-text detail
  paymentType           PaymentType? // how the money was returned (for REFUND)
  createdByUserId       String
  createdAt             DateTime        @default(now())

  bill      Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  visit     Visit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  testOrder TestOrder? @relation(fields: [testOrderId], references: [id], onDelete: SetNull)
  createdBy User       @relation("OrderRefundCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([billId])
  @@index([visitId])
  @@index([testOrderId])
  @@index([branchId, createdAt])
}

/// DiagnosticReport: Container for report versions
model DiagnosticReport {
  id        String   @id @default(cuid())
  visitId   String   @unique
  branchId  String
  createdAt DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  /// Versions (DRAFT → FINALIZED, immutable after finalized)
  versions ReportVersion[]

  // visitId is @unique, which already creates a btree that serves every lookup a plain
  // index would. Both were being maintained on every write.
  @@index([branchId])
}

/// ReportVersion: Versioned report (immutable once FINALIZED)
/// CONSTRAINT: Once status = FINALIZED, this row must not be updated.
/// Enforce via code: check status before any update.
model ReportVersion {
  id          String       @id @default(cuid())
  reportId    String
  versionNum  Int
  status      ReportStatus @default(DRAFT) // DRAFT | FINALIZED
  finalizedAt DateTime? // Set when FINALIZED
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt // Allowed only before FINALIZED

  // E3-10: Snapshot fields (frozen at finalization, NULL while DRAFT)
  panelsSnapshot          Json? // Panel layout + test groupings
  signaturesSnapshot      Json? // Signing doctor details + images
  labInchargeSnapshot     Json? // Signing lab incharge details + image
  patientSnapshot         Json? // Patient demographics at finalization
  visitSnapshot           Json? // Visit metadata at finalization
  interpretationsSnapshot Json? // Resolved interpretation texts
  externalUploadsSnapshot Json? // EXTERNAL_UPLOAD product metadata + R2 keys at finalization

  report DiagnosticReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// Test results for this version
  testResults TestResult[]

  // E3-10: Access control
  accessTokens ReportAccessToken[]
  accessLogs   ReportAccessLog[]
  smartReport  SmartReport?

  @@unique([reportId, versionNum])
  @@index([status])
  @@index([finalizedAt])
}

/// TestResult: Individual test result in a report version
/// IMMUTABLE once report is finalized.
/// DUAL FK: testId (old LabTest) + testDefinitionId (new TestDefinition) during migration.
model TestResult {
  id              String          @id @default(cuid())
  testOrderId     String
  testId          String // The actual test (can be sub-test of ordered panel)
  reportVersionId String
  value           Float? // Numeric result (can be null)
  textValue       String? // Text-based result (e.g., "Positive", "Negative")
  flag            TestResultFlag? // NORMAL | HIGH | LOW
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt // last edit to this value (for audit "when re-edited")

  // New architecture: dual FK
  testDefinitionId String? // New-arch FK (nullable during migration)

  // Staff member who entered this result. Nullable: legacy rows have no known
  // user, and carry-forward rows preserve the *original* entrant on re-issue.
  enteredByUserId String?

  // Per-narrative-report signer override. Free-text doctor name the radiologist
  // (or whoever enters the report) types in the dedicated "Doctor's Name" field
  // below the framed editor. When set, the PDF signature block prints just this
  // name above the department designation — no degrees / reg-no — overriding
  // any configured SigningRule for that page. Nullable: only narrative reports
  // surface the input today.
  signerNameOverride      String?
  // Narrative/text reports only. When the department has a configured
  // SigningRule, this per-report choice decides the signature: true = use the
  // rule's full signing-doctor block (like tabular reports); false/null = the
  // typed signerNameOverride + "Consultant <Dept>" designation. NULL on old
  // rows preserves the previous "rule always wins" behavior at render time.
  useSigningRule          Boolean?
  // Narrative/text reports whose department has MULTIPLE SigningRules (e.g.
  // radiology, where several radiologists each have a rule). When useSigningRule
  // is true, this pins the ONE signing doctor (SigningDoctor.id) that actually
  // read this report, so the renderer prints just that doctor's block instead
  // of every configured signature. NULL = not pinned: single-rule departments
  // and legacy rows keep the "render all configured rules" behavior. Stored as
  // a loose id (no FK) — signatures are resolved live at render, matching how
  // the rest of the signing pipeline treats doctors as live lookups.
  selectedSigningDoctorId String?

  testOrder      TestOrder       @relation(fields: [testOrderId], references: [id], onDelete: Cascade)
  test           LabTest         @relation(fields: [testId], references: [id], onDelete: Restrict)
  testDefinition TestDefinition? @relation(fields: [testDefinitionId], references: [id], onDelete: Restrict)
  reportVersion  ReportVersion   @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)
  enteredBy      User?           @relation("TestResultEnteredBy", fields: [enteredByUserId], references: [id], onDelete: SetNull)

  @@unique([reportVersionId, testOrderId, testId])
  @@index([testOrderId])
  @@index([testId])
  @@index([testDefinitionId])
  @@index([reportVersionId])
  @@index([enteredByUserId])
}

/// ClinicVisit: Clinic-specific data (references Visit)
/// NOTE: ClinicVisit.status = queue state (WAITING/IN_PROGRESS/COMPLETED)
///       Visit.status = overall lifecycle (DRAFT/WAITING/IN_PROGRESS/COMPLETED/CANCELLED)
model ClinicVisit {
  id                     String          @id @default(cuid())
  visitId                String          @unique
  clinicDoctorId         String
  visitType              ClinicVisitType
  hospitalWard           String?
  consultationFeeInPaise Int
  isRevisit              Boolean         @default(false)
  originalVisitId        String? // Points to the original Visit.id this is a follow-up of
  status                 VisitStatus     @default(WAITING) // Queue state: WAITING | IN_PROGRESS | COMPLETED
  startedAt              DateTime? // First transition to IN_PROGRESS
  completedAt            DateTime? // First transition to COMPLETED
  /// How a visit closed WITHOUT a digital prescription, while the module was on:
  /// "NONE" = the doctor pressed "Done, no prescription"; "PAPER" = reception closed
  /// it, so whatever was prescribed was written on the pad. Null = a digital one
  /// exists, the module was off, or the visit predates it.
  rxOutcome              String?
  tokenNumber            Int? // Daily branch OP queue token shown on the waiting-room display (null for IP)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  visit        Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  clinicDoctor ClinicDoctor @relation(fields: [clinicDoctorId], references: [id], onDelete: Restrict)

  @@index([visitId])
  @@index([clinicDoctorId])
  @@index([status])
  @@index([startedAt])
  @@index([completedAt])
}

// ============================================================================
// PAYOUT SYSTEM
// ============================================================================

/// DoctorPayoutRule: Configuration for payout derivation (future use)
model DoctorPayoutRule {
  id                    String   @id @default(cuid())
  referralDoctorId      String
  baseCommissionPercent Float    @default(10.0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([referralDoctorId])
}

/// DoctorPayoutLedger: what accrued to a payee over a period. A BOOK, not a
/// tracker — it records how much is owed, never whether it moved. Settlement
/// state (paidAt / reviewedAt / paymentMethod / paymentReferenceId) was removed
/// on 16 Sep 2026: of 1,602 live rows only 6 were ever marked paid, the last on
/// 26 Jun 2026, while rows kept deriving daily. Re-derivation is always safe
/// because the amounts come from TestOrder snapshots frozen at order time.
/// DERIVATION: 
///   - REFERRAL: Sum of (test price × commission %) for all finalized tests in period
///   - CLINIC: Sum of consultation fees for all completed visits in period
model DoctorPayoutLedger {
  id                   String           @id @default(cuid())
  doctorType           PayoutDoctorType // REFERRAL | CLINIC | DIAGNOSTIC_CENTER
  referralDoctorId     String? // Set when doctorType = REFERRAL
  clinicDoctorId       String? // Set when doctorType = CLINIC
  partnerId            String? // Set when doctorType = PARTNER
  branchId             String
  periodStartDate      DateTime
  periodEndDate        DateTime
  derivedAmountInPaise Int // Fully derived, not manual
  derivedAt            DateTime // When calculation was done
  notes                String?
  createdAt            DateTime         @default(now())
  deletedAt            DateTime? // Soft delete: hidden from all views; partial unique index allows re-derive after delete

  referralDoctor   ReferralDoctor?           @relation(fields: [referralDoctorId], references: [id], onDelete: Restrict)
  clinicDoctor     ClinicDoctor?             @relation(fields: [clinicDoctorId], references: [id], onDelete: Restrict)
  partner          Partner?                  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  branch           Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  statementTokens  StatementAccessToken[]

  // Uniqueness on (doctor, period, branch) is enforced by a partial unique index
  // (WHERE deletedAt IS NULL) created in migration 20260511000000_add_payout_soft_delete.
  // Prisma cannot express partial uniques, so we declare a regular index here for
  // query performance only; the partial unique constraint lives in raw SQL.
  @@index([doctorType, referralDoctorId, clinicDoctorId, partnerId, branchId, periodStartDate, periodEndDate], name: "DoctorPayoutLedger_lookup_idx")
  @@index([doctorType])
  @@index([referralDoctorId])
  @@index([clinicDoctorId])
  @@index([partnerId])
  @@index([branchId])
  @@index([deletedAt])
}

// ============================================================================
// AUDIT LOG (APPEND-ONLY EVENT STREAM)
// ============================================================================

/// AuditLog: Immutable append-only record of all critical actions
/// RULE: Insert only. No updates. No deletes.
/// ENFORCEMENT: Declare as insert-only in code; never update/delete.
model AuditLog {
  id         String          @id @default(cuid())
  branchId   String
  actionType AuditActionType
  entityType String // Visit, TestOrder, ReportVersion, etc.
  entityId   String
  userId     String?
  oldValues  String? // JSON string (if applicable)
  newValues  String? // JSON string (if applicable)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime        @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([actionType])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

/// AnomalyEvent: materialized read-model for the Audit & Anomalies page. One row
/// per surfaced incident, PROJECTED from the underlying sources (AuditLog, Bill
/// discounts, OrderRefund, …) with severity/category/score/amount stored as
/// columns — so the page can keyset-paginate and filter by severity/category in
/// plain SQL over a 1-year window without merging six live queries. Idempotent
/// upsert by dedupeKey; never the source of truth (safe to drop + reproject).
model AnomalyEvent {
  id            String   @id @default(cuid())
  branchId      String
  occurredAt    DateTime
  severity      String // high | medium | low | info
  category      String // money | report | drafts | identity | access | destructive | ops
  score         Int      @default(0)
  event         String
  detail        String   @default("")
  actorUserId   String?
  actorName     String?
  actorRole     String?
  entityType    String
  entityId      String
  patientName   String?
  amountInPaise Int?
  reason        String?
  drillTo       String?
  sourceKind    String // audit | discount | refund | reopen
  sourceId      String
  dedupeKey     String   @unique
  createdAt     DateTime @default(now())

  triage AnomalyTriage?

  @@index([branchId, occurredAt])
  @@index([branchId, severity, occurredAt])
  @@index([branchId, category, occurredAt])
  @@index([branchId, actorUserId, occurredAt])
  // The reversal self-join matches a later event to an earlier one on THREE alternative
  // key pairs. dedupeKey was already unique; these two were not indexed at all, so each
  // outer row fell back to scanning branchId_occurredAt end to end — branchId is not
  // constrained in an all-branches report — and testing the pairs as a post-filter.
  @@index([entityType, entityId])
  @@index([sourceKind, sourceId])
}

/// AnomalyTriage: per-event workqueue state (Acknowledge / Resolve). Kept in a
/// SEPARATE table so re-projecting AnomalyEvent never wipes it; absence of a row
/// = still "new". One row per event.
model AnomalyTriage {
  id             String   @id @default(cuid())
  anomalyEventId String   @unique
  status         String // ack | resolved
  note           String?
  actorUserId    String?
  actorName      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  anomalyEvent AnomalyEvent @relation(fields: [anomalyEventId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ============================================================================
// PATIENT CHANGE LOG (Identity Field Tracking)
// ============================================================================

/// PatientChangeLog: Immutable record of all patient field changes
/// RULE: Insert only. No updates. No deletes.
/// PURPOSE: Track identity field changes with mandatory reasons (staff)
model PatientChangeLog {
  id           String            @id @default(cuid())
  patientId    String
  fieldName    String
  oldValue     String?
  newValue     String?
  changeType   PatientChangeType // IDENTITY or NON_IDENTITY
  changeReason String? // Mandatory for IDENTITY changes by staff
  changedBy    String // User ID
  changedRole  String // staff, admin, owner
  requestId    String? // Optional: group multiple field changes
  createdAt    DateTime          @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([changeType])
  @@index([changedBy])
  @@index([createdAt])
  @@index([requestId])
}

enum PatientChangeType {
  IDENTITY
  NON_IDENTITY
}

// ============================================================================
// MESSAGE DELIVERY (WhatsApp Cloud API + SMS fallback)
// ============================================================================

/// MessageLog: Track all outbound messages (WhatsApp, SMS)
/// Generic enough for reports, bills, reminders, campaigns — contextType + contextId
model MessageLog {
  id               String             @id @default(cuid())
  patientId        String? // null for non-patient recipients (e.g. payout statements to doctors/labs)
  phone            String
  channel          MessageChannel // WHATSAPP | SMS
  templateName     String // e.g., lab_report_ready, bill_receipt
  templateParams   Json? // Template variable values
  waMessageId      String? // WhatsApp Cloud API message ID
  status           MessageStatus      @default(PENDING)
  failureReason    String?
  errorCode        String? // Meta WhatsApp error code (e.g. "131026") on FAILED rows; null otherwise
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  contextType      MessageContextType // REPORT | BILL | REMINDER | CAMPAIGN | PAYMENT
  contextId        String // visitId, billId, etc.
  /// Automation attribution. Together with stepIndex this is the send-idempotency key —
  /// a partial UNIQUE index (WHERE "automationRunId" IS NOT NULL) makes a replayed tick
  /// find this row instead of sending twice.
  automationRunId  String?
  automationStep   Int?
  /// Meta's classification AT SEND TIME. Known by whatsappCloudService for template
  /// management and previously thrown away; without it the consent split is unenforceable.
  templateCategory String? // UTILITY | MARKETING | AUTHENTICATION
  /// Snapshot of the template body as it read when sent. Meta edits templates in place
  /// with no version id, so without this the message a patient received is unrecoverable.
  templateBody     String?
  branchId         String? // Branch the message belongs to, derived from the visit at send time; null for historical rows
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Restrict)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([waMessageId])
  @@index([contextType, contextId])
  @@index([status])
  @@index([createdAt])
  @@index([branchId])
  @@index([patientId, templateCategory, createdAt])
  @@index([automationRunId])
}

// ============================================================================
// PATIENT MESSAGES INBOX (WhatsApp two-way)
// Kept separate from MessageLog (the outbound template-send ledger) so the hot
// notification write path is untouched and this stays an isolated, Axora-
// toggleable module. Capture happens in routes/webhooks.ts; read/reply APIs
// live under /api/messages (Phase 1).
// ============================================================================

/// A WhatsApp conversation thread with one phone number.
model Conversation {
  id            String             @id @default(cuid())
  phone         String             @unique // normalized "919876543210"
  patientId     String? // resolved from the last outbound message to this phone; null if no match
  branchId      String? // branch the patient last messaged from
  assignedToId  String? // staff user who claimed the thread (Phase 1)
  status        ConversationStatus @default(OPEN)
  lastInboundAt DateTime? // last time the patient messaged us — drives the 24h reply window
  lastMessageAt DateTime? // last activity (in or out) — list sort key
  lastPreview   String? // last message text, for the list preview
  unreadCount   Int                @default(0)
  autoRepliedAt DateTime? // last generic auto-reply time (rate-limits it to once per window)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  patient  Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)
  branch   Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  messages ConversationMessage[]

  @@index([status, lastMessageAt])
  @@index([branchId])
  @@index([patientId])
  @@index([lastMessageAt])
}

/// One message inside a Conversation (inbound patient message or outbound reply).
model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  body           String // text body, or a caption/placeholder for media
  messageType    String           @default("text") // text | image | document | audio | video | location | other
  status         String           @default("sent") // OUT delivery: sent → delivered → read (or failed); drives WhatsApp-style ticks
  mediaUrl       String? // R2 URL for stored inbound media (Phase 2)
  waMessageId    String?          @unique // Meta message id; unique so webhook retries don't double-insert
  staffUserId    String? // staff who sent an OUT message; null for inbound / auto-reply
  isAutoReply    Boolean          @default(false)
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

// ============================================================================
// E3-10: REPORT RENDERING ENGINE
// ============================================================================

/// Department: Groups panels for section headers on reports
/// e.g., "DEPARTMENT OF HAEMATOLOGY", "DEPARTMENT OF BIOCHEMISTRY"
model Department {
  id               String   @id @default(cuid())
  name             String   @unique // e.g., "HAEMATOLOGY", "BIOCHEMISTRY"
  reportHeaderText String // e.g., "DEPARTMENT OF HAEMATOLOGY"
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  showLabIncharge  Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  panels                     PanelDefinition[]
  signingRules               SigningRule[]
  labInchargeRuleDepartments LabInchargeRuleDepartment[]
  labTests                   LabTest[]
  clinicalPanels             ClinicalPanel[]
  testDefinitions            TestDefinition[]

  @@index([displayOrder])
  @@index([isActive])
}

/// PanelDefinition: Configurable report sections
/// Each panel has a layout type that determines how tests are rendered
model PanelDefinition {
  id               String          @id @default(cuid())
  name             String          @unique // e.g., "LFT", "CBP", "WIDAL"
  displayName      String // e.g., "LIVER FUNCTION TEST"
  departmentId     String
  layoutType       PanelLayoutType // Determines rendering strategy
  displayOrder     Int             @default(0)
  showMethodColumn Boolean         @default(false)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  department Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  testItems  PanelTestItem[]

  @@index([departmentId])
  @@index([displayOrder])
  @@index([isActive])
}

/// PanelTestItem: Tests within a panel, with display rules
/// Controls order, formatting, and method display per test
model PanelTestItem {
  id           String   @id @default(cuid())
  panelId      String
  testId       String
  displayOrder Int      @default(0)
  showMethod   Boolean  @default(false)
  methodText   String? // e.g., "Method: ECLIA"
  indentLevel  Int      @default(0) // 0=main, 1=sub-test
  isBold       Boolean  @default(false)
  isItalic     Boolean  @default(false)
  subGroup     String? // e.g., "MAIN", "DIFFERENTIAL", "SMEAR" for CBP layout
  createdAt    DateTime @default(now())

  panel PanelDefinition @relation(fields: [panelId], references: [id], onDelete: Cascade)
  test  LabTest         @relation(fields: [testId], references: [id], onDelete: Restrict)

  @@unique([panelId, testId])
  @@index([panelId])
  @@index([testId])
}

/// SigningDoctor: Doctors who sign diagnostic reports
/// Stores credentials and signature image reference
model SigningDoctor {
  id                   String   @id @default(cuid())
  name                 String
  degrees              String // e.g., "MBBS, MD (Pathology)"
  designation          String // e.g., "Consultant Pathologist"
  registrationNumber   String? // Medical council registration
  signatureImagePath   String? // Path to signature PNG in storage (set after upload)
  signatureImageBase64 String? // Base64 data URI — persists across deploys (Render safe)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  signingRules SigningRule[]

  @@index([isActive])
}

/// SigningRule: Which doctor signs which department
/// Multiple signers allowed per department
model SigningRule {
  id                  String   @id @default(cuid())
  departmentId        String
  signingDoctorId     String
  showLabInchargeNote Boolean  @default(true) // Show the Lab Incharge block on this department's reports
  displayOrder        Int      @default(0) // Multiple signers order
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  department    Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  signingDoctor SigningDoctor @relation(fields: [signingDoctorId], references: [id], onDelete: Restrict)

  @@unique([departmentId, signingDoctorId])
  @@index([departmentId])
  @@index([signingDoctorId])
}

/// SigningLabIncharge: Lab staff who sign diagnostic reports
/// Stores name, designation, and signature image reference
model SigningLabIncharge {
  id                   String   @id @default(cuid())
  name                 String
  designation          String   @default("Lab Incharge")
  signatureImagePath   String? // Path to signature PNG in storage (set after upload)
  signatureImageBase64 String? // Base64 data URI — persists across deploys (Render safe)
  /// When true, the digital signature image also prints on physical (letterhead)
  /// reports. Default false keeps the legacy behavior: physical prints show a
  /// blank Lab Incharge line for a wet signature (only the digital PDF signs).
  showSignatureOnPrint Boolean  @default(false)
  /// When true, the incharge's name + designation render under the signature on
  /// BOTH digital and physical reports (like a doctor block). Default false keeps
  /// the legacy behavior: only the "Lab Incharge" label shows.
  showNameOnPrint      Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  labInchargeRules LabInchargeRule[]

  @@index([isActive])
}

/// LabInchargeRule: Which lab incharge signs for which branch + department.
/// At most one active rule per (branch, department) slot — NULL branchId = All
/// Branches, NULL departmentId = All Departments. A report resolves its incharge
/// most-specific-first: (branch,dept) → (branch,All) → (All,dept) → (All,All).
/// One lab incharge may own many rules (different branches / departments).
/// A rule covers a SET of departments (LabInchargeRuleDepartment). A rule with
/// NO department rows = All Departments. "One incharge per (branch, dept) slot"
/// is enforced in the app layer (a branch may keep an All-Departments catch-all
/// plus specific-department overrides).
model LabInchargeRule {
  id                   String   @id @default(cuid())
  signingLabInchargeId String
  branchId             String? // NULL = All Branches
  displayOrder         Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  signingLabIncharge SigningLabIncharge          @relation(fields: [signingLabInchargeId], references: [id], onDelete: Restrict)
  branch             Branch?                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  departments        LabInchargeRuleDepartment[]

  @@index([signingLabInchargeId])
  @@index([branchId])
}

/// The departments a LabInchargeRule signs for. No rows for a rule = All
/// Departments (branch default); one or more rows scope it to those departments.
model LabInchargeRuleDepartment {
  ruleId       String
  departmentId String

  rule       LabInchargeRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  department Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([ruleId, departmentId])
  @@index([departmentId])
}

/// InterpretationTemplate: Range-based interpretation text
/// Matched against test value to generate interpretation on report
model InterpretationTemplate {
  id                 String   @id @default(cuid())
  testId             String
  minValue           Float? // NULL = no lower bound
  maxValue           Float? // NULL = no upper bound
  interpretationText String // The interpretation text
  displayOrder       Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  test LabTest @relation(fields: [testId], references: [id], onDelete: Restrict)

  @@index([testId])
  @@index([isActive])
}

/// ReportAccessToken: Secure patient access links
/// Token maps to specific finalized ReportVersion
model ReportAccessToken {
  id              String    @id @default(cuid())
  token           String    @unique // SHA-256 hash of the bearer token
  reportVersionId String
  expiresAt       DateTime? // NULL = never expires
  revokedAt       DateTime? // set when the underlying report/bill is voided → blocks the link
  accessCount     Int       @default(0)
  lastAccessedAt  DateTime?
  lastAccessedIp  String?
  createdAt       DateTime  @default(now())

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId])
  @@index([expiresAt])
}

/// ReportAccessLog: Audit trail for report views/downloads
/// Append-only log of all access events
model ReportAccessLog {
  id              String   @id @default(cuid())
  reportVersionId String
  accessType      String // 'VIEW', 'DOWNLOAD', 'PRINT'
  accessedVia     String // 'TOKEN', 'STAFF_PORTAL', 'DIRECT', 'PATIENT_PORTAL'
  ipAddress       String?
  userAgent       String?
  userId          String? // Staff user if authenticated
  actorPhone      String? // logged-in patient's phone for PATIENT_PORTAL rows (owner-only audit)
  createdAt       DateTime @default(now())

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([reportVersionId])
  @@index([accessType])
  @@index([createdAt])
}

/// BillAccessLog: audit trail for bill views/downloads (bills have no ReportVersion,
/// so they can't live in ReportAccessLog). Denormalised patient/bill fields so the
/// row is a self-contained, immutable disclosure record.
model BillAccessLog {
  id          String   @id @default(cuid())
  visitId     String
  billNumber  String?
  patientName String?
  accessType  String // 'VIEW', 'DOWNLOAD', 'PRINT'
  accessedVia String // 'PATIENT_PORTAL', 'TOKEN', 'STAFF_PORTAL'
  actorPhone  String? // logged-in patient's phone for PATIENT_PORTAL rows
  ipAddress   String?
  userAgent   String?
  userId      String? // staff user if authenticated
  createdAt   DateTime @default(now())

  @@index([visitId])
  @@index([createdAt])
}

/// PatientAuthEvent: persisted patient-portal auth trail (logins etc.) so "who / how
/// many logged in" is queryable. Full phone here (owner-only DB); app logs stay tail-masked.
model PatientAuthEvent {
  id        String   @id @default(cuid())
  event     String // 'LOGIN_SUCCESS', 'OTP_REQUESTED', 'OTP_FAILED', 'LOCKOUT', 'LOGOUT'
  phone     String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

// ─── Age-Based Reference Ranges ──────────────────────────────────
model TestAgeRange {
  id            String   @id @default(cuid())
  testId        String
  minAgeDays    Int? // age stored in total days (0 = newborn). Helpers: 1y=365, 1m=30
  maxAgeDays    Int? // null = no upper limit
  gender        Gender?
  referenceMin  Float?
  referenceMax  Float?
  referenceUnit String?
  referenceText String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  test LabTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, minAgeDays, maxAgeDays, gender])
  @@index([testId])
}

// ─── Derived Parameters (formula-based calculated values) ────────
model DerivedParameter {
  id                 String   @id @default(cuid())
  testId             String   @unique
  parameterName      String
  formula            String
  dependsOnTestCodes Json
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  test LabTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

// ─── Diagnostic Referral Centers ─────────────────────────────────
// ─── Diagnostic Center ↔ Visit Join Table ────────────────────────
// ─── Partners (outside labs & referring centres) ─────────────────────────────

/// Partner: one organisation we are tied up with — an outside lab, a referring
/// hospital, a diagnostic centre. Replaces ExternalLab (we send out) and
/// DiagnosticReferralCenter (they send in), which were the same relationship
/// modelled twice in opposite directions: a real partner is usually both.
/// Money direction lives on PartnerArrangement, never on the partner itself.
model Partner {
  id            String  @id @default(cuid())
  partnerNumber String  @unique // PT-00001
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean @default(true)

  /// Patient-facing doors. sendBill OFF closes the bill WhatsApp and the bill
  /// QR/token link, and greys the counter Print button — the partner already
  /// billed this patient, so handing over ours is a second bill for one test.
  /// allowBillPrint re-opens the counter print ALONE, for the partner who is
  /// happy for the patient to walk out with our slip. It means nothing while
  /// sendBill is on, and never re-opens the WhatsApp or the link.
  sendBill       Boolean @default(false)
  allowBillPrint Boolean @default(false)
  sendReport     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arrangements PartnerArrangement[]
  visits       PartnerVisit[]
  testOrders   TestOrder[]
  payoutLedger DoctorPayoutLedger[]

  @@index([isActive])
  @@index([createdAt])
}

/// PartnerArrangement: ONE deal with a partner, and the bottom rung of its rate
/// ladder. A partner holds at most one arrangement of each kind.
model PartnerArrangement {
  id        String                 @id @default(cuid())
  partnerId String
  kind      PartnerArrangementKind
  isActive  Boolean                @default(true)

  /// True when the patient's money crosses OUR counter for work under this deal.
  /// Implied by kind for the two we ship with a user, but stored rather than
  /// inferred so a partner who settles differently is one column, not a new kind.
  weCollect Boolean

  /// Default rate for this deal — overridden by category, then product rules.
  ///
  /// A rate ALWAYS expresses OUR SHARE: what we keep, never what they take. One
  /// meaning across all three kinds, so it can never be read inverted:
  ///   INBOUND_BILLED_HERE  we collect ₹300, our share 20% ⇒ keep ₹60, owe them ₹240
  ///   INBOUND_BILLED_THERE they collect ₹300, our share 20% ⇒ they owe us ₹60
  ///   OUTBOUND_VENDOR      we collect ₹750, our share 40% ⇒ keep ₹300, owe them ₹450
  /// partnerCut is therefore always (standing charge − our share) when we collect,
  /// and zero when they do — nothing flows from us on work we never billed.
  rateBasis         PartnerRateBasis @default(PCT_OF_OUR_PRICE)
  ratePercent       Float?
  rateAmountInPaise Int?

  /// How the referring doctor is paid on this deal's work.
  doctorCommissionMode PartnerDoctorCommissionMode @default(OUR_SHARE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner       Partner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  categoryRules PartnerCategoryRule[]
  productRules  PartnerProductRule[]

  @@unique([partnerId, kind])
  @@index([partnerId])
}

/// PartnerCategoryRule: this deal's rate for one payout category (Laboratory,
/// CT / MRI, …). `category` is the same free-text taxonomy as
/// BillableProduct.payoutCategory and ReferralCategoryRate — no FK, categories
/// are centre-defined strings.
model PartnerCategoryRule {
  id            String @id @default(cuid())
  arrangementId String
  /// null = every branch; set = per-branch override, as on ReferralCategoryRate.
  branchId      String?
  category      String

  rateBasis         PartnerRateBasis
  ratePercent       Float?
  rateAmountInPaise Int?

  /// null = inherit the arrangement's mode.
  doctorCommissionMode PartnerDoctorCommissionMode?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arrangement PartnerArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  branch      Branch?            @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([arrangementId, branchId, category])
  @@index([arrangementId])
  @@index([branchId])
}

/// PartnerProductRule: this deal's rate for one BillableProduct — the rung a real
/// lab rate card lands on (Lalitha: CBP ₹60, CRP ₹100, URINE C/S ₹100, ESR ₹50).
/// Keyed on the PRODUCT, not the leaf test: a CBP is 13 TestOrder rows, and the
/// ₹60 is distributed across them at order time.
model PartnerProductRule {
  id            String  @id @default(cuid())
  arrangementId String
  /// null = every branch; set = per-branch override.
  branchId      String?
  productId     String

  rateBasis         PartnerRateBasis
  ratePercent       Float?
  rateAmountInPaise Int?

  /// null = inherit the arrangement's mode.
  doctorCommissionMode PartnerDoctorCommissionMode?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arrangement PartnerArrangement @relation(fields: [arrangementId], references: [id], onDelete: Cascade)
  product     BillableProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch      Branch?            @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([arrangementId, branchId, productId])
  @@index([arrangementId])
  @@index([productId])
  @@index([branchId])
}

/// PartnerVisit: this visit came from (or went to) a partner. Replaces
/// DiagnosticCenter_Visit. One partner per visit — a visit has one source.
model PartnerVisit {
  id        String                 @id @default(cuid())
  visitId   String                 @unique
  partnerId String
  branchId  String
  /// Frozen: which deal sourced this visit. Kept here as well as on each order so
  /// a visit-level read never has to join orders to know where it came from.
  kind      PartnerArrangementKind

  /// What the PARTNER charged the patient, in paise. Recorded when they billed
  /// (Lalitha's ₹300, the referring hospital's ₹1,500). Null when we billed.
  /// Never summed into a money total — it is theirs, not ours. Display only,
  /// except where a rule's basis is PCT_OF_PARTNER_BILLED.
  partnerBilledInPaise Int?

  createdAt DateTime @default(now())

  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([partnerId])
  @@index([branchId])
  @@index([kind])
}

// ============================================================================
// NEW ARCHITECTURE: TestDefinition → ClinicalPanel → BillableProduct
// ============================================================================

/// TestDefinition: Versioned clinical test definition (replaces LabTest for new data)
/// Uses clone-on-edit semantics: active version is isLatest=true.
/// Status lifecycle: ACTIVE → LOCKED → DEPRECATED → ARCHIVED
/// NOTE: retestIntervalDays lives here, beside the reference ranges, because "how often
/// should this be repeated" is a clinical decision belonging to the clinicians who set the
/// ranges — not hard-coded in an automation as "thyroid = 90 days".
model TestDefinition {
  id                String               @id @default(cuid())
  rootDefinitionId  String // Points to first version's ID (groups versions)
  version           Int                  @default(1)
  previousVersionId String? // Previous version ID (null for v1)
  isLatest          Boolean              @default(true)
  status            TestDefinitionStatus @default(ACTIVE)

  name          String
  code          String // Unique among isLatest=true
  sampleType    String? // e.g., "Blood", "Serum", "Urine"
  method        String? // e.g., "ECLIA", "GOD-POD"
  referenceUnit String? // e.g., "g/dL", "mg/dL"
  /// How often this test should be repeated, in days. Null = no schedule. Read by the
  /// automation engine so "due in 7 days" is generic instead of "thyroid = 90" hard-coded.
  retestIntervalDays Int?
  departmentId  String?

  // Default reference range (fallback if no age/gender-specific range matches)
  referenceMin  Float?
  referenceMax  Float?
  referenceText String? // For text-based ranges like "Negative"
  criticalMin   Float? // Critical low threshold for general range
  criticalMax   Float? // Critical high threshold for general range

  // Derived parameter support
  formulaExpression String? // e.g., "ALB / GLOB"
  dependsOnCodes    Json    @default("[]") // String array of test codes

  // Interpretation
  interpretationMode InterpretationMode @default(NONE)

  displayOrder Int      @default(0)
  isActive     Boolean  @default(true) // Visibility flag — controls whether this definition appears in clinical forms
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  department          Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ranges              TestDefinitionRange[]
  interpretationRules InterpretationRule[]
  panelItems          ClinicalPanelItem[]
  testOrders          TestOrder[]
  testResults         TestResult[]
  productPanels       BillableProductPanel[] // Products that include this (via panels)

  @@unique([rootDefinitionId, version]) // Each root can only have one of each version number
  @@index([code, isLatest]) // Fast lookup for code uniqueness among latest
  @@index([rootDefinitionId])
  @@index([isLatest, status])
  @@index([code])
  @@index([departmentId])
  @@index([displayOrder])
}

/// TestDefinitionRange: Age/gender-specific reference ranges for a TestDefinition
model TestDefinitionRange {
  id               String         @id @default(cuid())
  testDefinitionId String
  category         RangeCategory? // UI selector: MALE, FEMALE, INFANT, CHILD, OTHER
  categoryLabel    String? // Custom label for OTHER category (e.g., "Pregnant")
  minAgeDays       Int? // age in total days (0 = newborn). null = no lower bound
  maxAgeDays       Int? // null = no upper limit
  gender           Gender? // null = gender-neutral
  referenceMin     Float?
  referenceMax     Float?
  referenceUnit    String?
  referenceText    String?
  criticalMin      Float? // Critical low threshold
  criticalMax      Float? // Critical high threshold
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  testDefinition TestDefinition @relation(fields: [testDefinitionId], references: [id], onDelete: Cascade)

  @@unique([testDefinitionId, category, categoryLabel, minAgeDays, maxAgeDays, gender])
  @@index([testDefinitionId])
}

/// InterpretationRule: Configurable interpretation rules for test results
/// Supports numeric range matching, text matching, and category matching
model InterpretationRule {
  id                 String                 @id @default(cuid())
  testDefinitionId   String
  ruleType           InterpretationRuleType
  operator           ComparisonOperator
  value1             Float? // Primary comparison value
  value2             Float? // Secondary value (for BETWEEN operator)
  textMatch          String? // For TEXT_MATCH / CATEGORY_MATCH rules
  interpretationText String // The interpretation text to display
  severity           String? // e.g., "normal", "caution", "critical"
  displayOrder       Int                    @default(0)
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  testDefinition TestDefinition @relation(fields: [testDefinitionId], references: [id], onDelete: Cascade)

  @@index([testDefinitionId])
  @@index([isActive])
}

/// ClinicalPanel: Report rendering groups (replaces PanelDefinition for new data)
/// Each panel has a layout type and config flags that control rendering
model ClinicalPanel {
  id                    String          @id @default(cuid())
  name                  String          @unique
  displayName           String // e.g., "LIVER FUNCTION TEST"
  departmentId          String
  layoutType            PanelLayoutType @default(STANDARD_TABLE)
  displayOrder          Int             @default(0)
  showMethodColumn      Boolean         @default(false)
  // Payout / referral category (e.g. "Laboratory", "X-Ray", "Ultrasound",
  // "ECG / Cardiology", "CT / MRI"). Set in Report Builder / panel definitions.
  // Freezes onto each TestOrder at billing (payoutCategorySnapshot) and drives
  // both the referral commission rate and the payout statement grouping. When
  // null the system falls back to name-inference (payoutCategorize.ts).
  payoutCategory        String?
  /// Smart Reports: Health Icons name, e.g. "body/liver". Falls back to name-match then stethoscope.
  icon                  String?
  sampleType            String? // e.g., "WB-EDTA", "Serum", "Urine"
  panelMethodText       String?
  panelMethodItalic     Boolean         @default(false)
  narrativeTemplateHtml String?

  // Config flags for STANDARD_TABLE rendering variants
  showSubgroups        Boolean @default(false) // true = render subGroup sections (e.g., CBP: MAIN/DIFFERENTIAL/SMEAR)
  showInterpretation   Boolean @default(false) // true = render interpretation block below results
  valueDisplayPrefix   String? // e.g., "1:" for Widal dilution format
  spacedDefinitionsGap Int     @default(0)

  summaryInterpretationTemplate String? // DEPRECATED: superseded by `comments`; retained for backfill/rollback
  comments                      String? // Rich-text (HTML) COMMENTS box below results. Gated by showInterpretation (the "Show Comments" toggle).
  interpretation                String? // Rich-text (HTML) INTERPRETATION box, rendered ABOVE comments when non-empty. Static for now (dynamic value-rules are future work).
  subgroupMethods               Json? // Map<subgroupName, methodString> e.g. {"PHYSICAL EXAMINATION": "Transmission refractometry"}
  subgroupTableOverrides        Json? // Map<subgroupName, true> — force table rendering even when heuristic says key-value
  isActive                      Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  department    Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  items         ClinicalPanelItem[]
  productPanels BillableProductPanel[]

  @@index([departmentId])
  @@index([displayOrder])
  @@index([isActive])
}

/// ClinicalPanelItem: Tests within a ClinicalPanel, with display rules
model ClinicalPanelItem {
  id               String   @id @default(cuid())
  panelId          String
  testDefinitionId String
  displayOrder     Int      @default(0)
  showMethod       Boolean  @default(false)
  methodText       String? // Override method text for this panel context
  displayLabel     String? // Per-panel row-label override; null = fall back to TestDefinition.name
  indentLevel      Int      @default(0)
  isBold           Boolean  @default(false)
  isItalic         Boolean  @default(false)
  subGroup         String? // e.g., "MAIN", "DIFFERENTIAL", "SMEAR" for subgroup rendering
  joinPrevious     Boolean  @default(false) // true: render on same line as previous item (by displayOrder)
  gridWidth        Int? // 1-12 grid units; null = auto / even split within the row
  createdAt        DateTime @default(now())

  panel          ClinicalPanel  @relation(fields: [panelId], references: [id], onDelete: Cascade)
  testDefinition TestDefinition @relation(fields: [testDefinitionId], references: [id], onDelete: Restrict)

  @@unique([panelId, testDefinitionId])
  @@index([panelId])
  @@index([testDefinitionId])
}

/// BillableProduct: Commercial products sold to patients
/// Decoupled from clinical definitions — purely commercial layer.
/// A product maps to one or more ClinicalPanels (not directly to TestDefinitions).
model BillableProduct {
  id                 String                 @id @default(cuid())
  name               String
  code               String                 @unique
  description        String?
  basePriceInPaise   Int // Default price (can be overridden per branch)
  isBundle           Boolean                @default(false) // true = package of multiple panels
  /// Smart Reports: bundles only, and only when the resolved package has no
  /// EXTERNAL_UPLOAD line and no TEXT_ONLY / IMAGING_NARRATIVE panel.
  smartReportEnabled Boolean                @default(false)
  workflowMode       DiagnosticWorkflowMode @default(REPORTABLE)
  couponCampaignId   String? // EVENT products only: the CouponCampaign to mint a coupon from when billed
  // Grouping bucket for the payout statement (e.g. "X-Ray", "Laboratory").
  // Owner-set per product; when null the statement falls back to the test's
  // department name. No fixed enum — the centre defines its own categories.
  payoutCategory     String?
  displayOrder       Int                    @default(0)
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  panels                BillableProductPanel[]        @relation("ProductLines")
  parentLines           BillableProductPanel[]        @relation("ProductChildren")
  branchPricing         ProductBranchPricing[]
  testOrders            TestOrder[]
  referralDoctorRules   ReferralDoctorProductRule[]
  partnerProductRules   PartnerProductRule[]
  referralProductRates  ReferralProductRate[]
  couponCampaign        CouponCampaign?               @relation(fields: [couponCampaignId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([isActive])
  @@index([displayOrder])
  @@index([workflowMode])
}

/// BillableProductPanel: Line items inside a billable product
/// Each line points at exactly one of: a ClinicalPanel (panelId) OR another
/// BillableProduct (childProductId). The latter lets a package include
/// bill-only items (e.g. sample collection charge) alongside panels, and
/// transparently picks up the child's panels if the child becomes reportable.
model BillableProductPanel {
  id               String   @id @default(cuid())
  productId        String
  panelId          String? // null when this line points at a child product instead
  childProductId   String? // null when this line points at a panel instead
  testDefinitionId String? // Optional: direct test reference for single-test products
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())

  product        BillableProduct  @relation("ProductLines", fields: [productId], references: [id], onDelete: Cascade)
  panel          ClinicalPanel?   @relation(fields: [panelId], references: [id], onDelete: Restrict)
  childProduct   BillableProduct? @relation("ProductChildren", fields: [childProductId], references: [id], onDelete: Restrict)
  testDefinition TestDefinition?  @relation(fields: [testDefinitionId], references: [id], onDelete: SetNull)

  @@unique([productId, panelId])
  @@unique([productId, childProductId])
  @@index([productId])
  @@index([panelId])
  @@index([childProductId])
}

/// ExternalReportUpload: PDF files attached to EXTERNAL_UPLOAD test orders.
/// Stored in Cloudflare R2; only the metadata + r2Key live in the database.
/// Soft-deleted via deletedAt so finalized snapshots can still resolve historical uploads.
model ExternalReportUpload {
  id               String    @id @default(cuid())
  testOrderId      String
  visitId          String // denormalized for visit-scope queries & cleanup
  r2Key            String // e.g. visits/{visitId}/uploads/{uuid}.pdf
  originalFilename String
  mimeType         String // always "application/pdf" for v1
  fileSizeBytes    Int
  pageCount        Int? // populated by pdf-lib at upload time
  displayOrder     Int       @default(0)
  uploadedByUserId String
  uploadedAt       DateTime  @default(now())
  deletedAt        DateTime?

  testOrder  TestOrder @relation(fields: [testOrderId], references: [id], onDelete: Cascade)
  visit      Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([testOrderId])
  @@index([visitId])
  @@index([deletedAt])
}

/// ProductBranchPricing: Per-branch price overrides for products
model ProductBranchPricing {
  id           String   @id @default(cuid())
  productId    String
  branchId     String
  priceInPaise Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product BillableProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([productId])
  @@index([branchId])
}

/// TestInputConfig: Entry-time UI configuration for a clinical test.
/// Keyed by rootDefinitionId so config is shared across every version of the test
/// (v1, v2, v3 of HB all share one row). Sits OUTSIDE the TestDefinition versioning
/// rules — these fields don't affect stored results or finalized reports, so admins
/// can edit them freely even on LOCKED test definitions. No row = use defaults
/// (NUMERIC, no presets, no default value).
model TestInputConfig {
  rootDefinitionId String        @id // Matches TestDefinition.rootDefinitionId (not a Prisma FK because that field isn't unique on TestDefinition — every version row carries the same rootDefinitionId)
  inputType        TestInputType @default(NUMERIC)
  defaultValue     String? // Optional pre-fill for the input on first entry
  valueOptions     Json          @default("[]") // string[] of preset values, in display order
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

/// DerivedParameterDef: Formula-based calculated parameters (new architecture)
/// Separate from TestDefinition for clarity, but linked 1:1
model DerivedParameterDef {
  id                 String   @id @default(cuid())
  testDefinitionCode String   @unique // Code of the test definition this derives
  parameterName      String
  formula            String // e.g., "ALB / GLOB"
  dependsOnTestCodes Json // String array: ["ALB", "GLOB"]
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// BillAccessToken: Secure public access tokens for bill PDF links sent via WhatsApp
/// Mirrors ReportAccessToken pattern — stores SHA-256 hash of the raw bearer token.
/// Token in DB = hash; raw token sent to patient; validate by hashing incoming.
model BillAccessToken {
  id             String    @id @default(cuid())
  token          String    @unique // SHA-256 hash of the raw bearer token
  visitId        String
  expiresAt      DateTime? // NULL = never expires
  revokedAt      DateTime? // set on full bill void (cancellation/refund) → blocks the link
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  lastAccessedIp String?
  createdAt      DateTime  @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([expiresAt])
}

/// LinkAccessLog: unified access log for every public WhatsApp link click.
/// Captures IP, device, OS, browser, referrer, and Accept-Language from the
/// incoming HTTP request — no external services needed. One row per access.
/// For coupons that lack a contextId (no visit/payout), store the coupon code.
/// Backfilled by trackLinkAccess() in linkAccessService.ts.
model LinkAccessLog {
  id             String   @id @default(cuid())
  linkType       String // BILL | REPORT | COUPON | STATEMENT
  linkToken      String // the raw public token (bearer, not hashed — already public)
  contextId      String? // visitId (bill/report), payoutId (statement), null (coupon)
  ipAddress      String?
  userAgentRaw   String?
  deviceModel    String?
  deviceVendor   String?
  osName         String?
  osVersion      String?
  browserName    String?
  browserVersion String?
  referrer       String?
  acceptLanguage String?
  createdAt      DateTime @default(now())

  @@index([linkType, createdAt])
  @@index([linkToken])
  @@index([contextId])
  @@index([createdAt])
}

/// StatementAccessToken: token-gated public access to a payout statement (sent to
/// referral doctors / clinics / diagnostic centers / outside labs on WhatsApp).
/// Mirrors BillAccessToken — SHA-256 hash stored; raw token is the bearer link.
model StatementAccessToken {
  id             String    @id @default(cuid())
  token          String    @unique // SHA-256 hash of the raw bearer token
  payoutId       String
  expiresAt      DateTime? // NULL = never expires
  revokedAt      DateTime? // set when the payout is voided → blocks the link
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  lastAccessedIp String?
  createdAt      DateTime  @default(now())

  payout DoctorPayoutLedger @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId])
  @@index([expiresAt])
}

// ============================================================================
// SMART REPORTS  (see SMART_REPORTS_PLAN.md)
// ============================================================================

enum SmartReportStatus {
  PENDING
  /// Written by the pre-finalize draft preview. Deliberately NOT READY: the
  /// notification service and the patient gateway both switch on status ===
  /// 'READY', and a draft shares its ReportVersion id with the finalized one, so
  /// writing READY early would arm the two-button WhatsApp and the patient smart
  /// link before anyone finalized anything. Promoted to READY at finalize.
  DRAFT
  READY
  FAILED
  SKIPPED
}

/// One per finalized ReportVersion. Regeneration REPLACES in place (decision:
/// generation only happens at the FINAL finalize, so regeneration is rare).
model SmartReport {
  id              String            @id @default(cuid())
  reportVersionId String            @unique
  visitId         String
  patientId       String
  branchId        String
  status          SmartReportStatus @default(PENDING)
  /// NO_SMART_REPORT_PRODUCT | PACKAGE_NO_LONGER_ELIGIBLE | NO_ANALYSABLE_TESTS
  /// | BELOW_MIN_PARAMETERS | PATIENT_BELOW_MIN_AGE | DISABLED | LINK_DISABLED
  /// | NO_MEASUREMENTS (height/weight not captured at billing)
  skipReason      String?
  language        String            @default("en")

  score            Int?
  scoreBand        String? // ON_TRACK | MOSTLY_ON_TRACK | NEEDS_WORK | SEE_DOCTOR
  scoredCount      Int     @default(0)
  outOfRangeCount  Int     @default(0)
  borderlineCount  Int     @default(0)
  withinRangeCount Int     @default(0)
  shownNotScored   Int     @default(0)
  referredOnly     Int     @default(0)
  hasCritical      Boolean @default(false)

  /// Deterministic output (findings, buckets, trends, chosen content). The audit record.
  findings         Json?
  /// Validated LLM output: testScore, findingExplanations, advisory.
  content          Json?
  usedFallbackCopy Boolean @default(false)

  /// Staff kill switch, set AFTER the fact. Generation and the first send are
  /// fire-and-forget at finalize, so this cannot pre-empt the first message; what
  /// it does is stop the smart link being served and make every resend fall back
  /// to the plain one-button template. For a Smart Report that reads wrong.
  sendSuppressedAt     DateTime?
  sendSuppressedBy     String?
  sendSuppressedReason String?
  validationFailures   Json?

  /// sha256 of the de-identified model payload. The payload IS the model's whole
  /// input, so an identical hash means identical input: reuse the stored content
  /// instead of paying for a second, non-deterministic generation. Any edited
  /// result changes a finding, which changes the payload, which changes this —
  /// invalidation is automatic and needs no cache-busting anywhere.
  inputHash      String?
  /// When the draft preview last produced this row. Not an approval: pre-warm
  /// fires when the preview modal opens, so staff may never have read it.
  previewedAt    DateTime?
  model          String?
  promptVersion  String?
  inputTokens    Int?
  outputTokens   Int?
  generationMs   Int?
  configSnapshot Json?
  generatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([patientId])
  @@index([branchId, createdAt])
  @@index([status])
}

/// Null branchId = the global default (same pattern as ReferralCategoryRate).
model SmartReportConfig {
  id                     String   @id @default(cuid())
  branchId               String?  @unique
  enabled                Boolean  @default(false)
  recommendationsEnabled Boolean  @default(true)
  futureTestsEnabled     Boolean  @default(true)
  trendsEnabled          Boolean  @default(true)
  essentialsEnabled      Boolean  @default(true)
  language               String   @default("en")
  accentColor            String   @default("#3FA34D")
  tagline                String?
  websiteLine            String?
  disclaimerOverride     String?
  /// Test codes the Smart Report must never score. Some rows on a report are
  /// properties of the SAMPLE rather than findings about the patient — urine
  /// volume is the clear case — and scoring them tells a patient something is
  /// wrong with them when nothing is. There is no reliable automatic signal for
  /// this, so it is an explicit list the centre owns.
  excludedTestCodes      String[] @default(["CUE_QTY", "CUE_COL", "CUE_APP", "CUE_RXN", "CUE_SG"])
  minScoredParameters    Int      @default(5)
  minPatientAgeYears     Int      @default(18)
  maxFindingPages        Int      @default(3)
  model                  String   @default("deepseek-v4-flash")
  monthlyBudgetPaise     Int?
  updatedAt              DateTime @updatedAt
}

/// Patient-facing content catalog. Trigger shape mirrors InterpretationRule so the
/// existing matcher semantics carry over; the TEXT is patient-facing, unlike
/// InterpretationRule.interpretationText which names conditions.
model HealthContentRule {
  id                 String   @id @default(cuid())
  language           String   @default("en")
  testCode           String
  direction          String // HIGH | LOW | ANY
  tier               Int      @default(1) // 1 = explanation only, 2 = + advice
  title              String
  whatItMeans        String
  dos                Json     @default("[]")
  donts              Json     @default("[]")
  lifestyle          Json     @default("[]")
  suggestedTestCodes Json     @default("[]")
  followUpWeeks      Int?
  severity           String   @default("STANDARD")
  displayOrder       Int      @default(0)
  isActive           Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  @@unique([language, testCode, direction])
  @@index([testCode, direction])
  @@index([isActive])
}

// ============================================================================
// Automated messages — scheduled WhatsApp sends the centre configures itself.
// ============================================================================

/// ScheduledMessage: one configured automatic send. Today the only kind is the
/// nightly day sheet, one row per (branch, domain) so a centre can have the
/// diagnostic sheet on and the OP sheet off, at different times, per branch.
///
/// branchId is a plain scalar rather than a relation, matching ReportAccessLog:
/// this is configuration ABOUT a branch, not data owned by it, and a row for a
/// branch that no longer exists is inert (the tick skips it) rather than a
/// migration hazard.
model ScheduledMessage {
  id            String   @id @default(cuid())
  kind          String // 'DAY_SHEET' — the only kind today
  branchId      String
  domain        String // 'DIAGNOSTICS' | 'CLINIC'
  enabled       Boolean  @default(false)
  /// Send time as minutes past midnight IST. 1350 = 22:30. Stored as minutes
  /// rather than a DateTime because it is a time-of-day, not an instant, and
  /// IST has no DST to complicate it.
  sendAtMinutes Int      @default(1350)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([kind, branchId, domain])
}

/// ScheduledMessageRun: one row per send that has been attempted, keyed by the
/// DAY the sheet covers. This is what makes the ticker safe: the unique key
/// means a redeploy, a restart, a slow tick or a second instance cannot send
/// the same night's sheet twice, and a box that was asleep at the send time
/// still sends on wake instead of silently skipping.
model ScheduledMessageRun {
  id       String   @id @default(cuid())
  kind     String
  branchId String
  domain   String
  /// IST calendar date the sheet covers, 'YYYY-MM-DD'.
  runDate  String
  status   String // SENT | FAILED | SKIPPED
  detail   String? // failure reason, or why it was skipped
  sentAt   DateTime @default(now())

  @@unique([kind, branchId, domain, runDate])
  @@index([sentAt])
}

/// DaySheetAccessToken: bearer link to one night's day sheet, mirroring
/// BillAccessToken / ReportAccessToken exactly — SHA-256 hash stored, raw token
/// sent in the WhatsApp URL, access counted on every open.
///
/// Unlike a bill token this one ALWAYS expires. A bill link is a patient's own
/// receipt and may live forever; this is a branch's takings for a day, so the
/// link stops working once it has served the purpose it was sent for.
model DaySheetAccessToken {
  id             String    @id @default(cuid())
  token          String    @unique // SHA-256 hash of the raw bearer token
  branchId       String
  domain         String // 'DIAGNOSTICS' | 'CLINIC'
  /// IST calendar date the sheet covers, 'YYYY-MM-DD'.
  sheetDate      String
  expiresAt      DateTime
  revokedAt      DateTime?
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  lastAccessedIp String?
  createdAt      DateTime  @default(now())

  @@index([branchId, sheetDate])
  @@index([expiresAt])
}

// ============================================================================
// AUTOMATIONS ENGINE
//
// Generalises ScheduledMessageRun. The safety property is the one the day sheet
// already relies on: a UNIQUE key claimed BEFORE the side effect, so a redeploy,
// a restart, a slow tick or a second instance cannot act twice.
//
// Deliberately absent: a DAG, branch nodes, a rule DSL, a segment entity and an
// AutomationVersion table. Steps are an array with stepIndex on the run, and the
// run carries a FROZEN copy of the definition — which is the whole versioning
// story, with no joins and no lifecycle.
// ============================================================================

/// One automation. `definition` is the EDITABLE copy; a run freezes it at enrolment.
model Automation {
  id    String @id @default(cuid())
  key   String @unique // CLINIC_TO_DX_RECOVERY, DAY_SHEET_DIAGNOSTICS
  name  String
  group String // Patient journeys | Conversations | Reports to your team
  /// trigger + reentry + audience + goal + steps. Shape in services/automations/types.ts.
  definition Json
  /// Bumped on each activation and copied to the run, so Results can group by it and an
  /// in-flight run is never silently moved onto new rules.
  version    Int       @default(1)
  enabled    Boolean   @default(false)
  /// The watermark. Runs enrol only subjects created AFTER this instant — the alternative
  /// is a first save that silently messages six months of history. Null = never activated.
  activatedAt DateTime?
  /// 0-20. Frozen at activation; changing it later does not re-bucket anyone.
  holdoutPct Int      @default(0)
  /// 1-5. Breaks contention when two proactive journeys want the same patient today.
  priority   Int      @default(3)
  branchIds  String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  runs AutomationRun[]

  @@index([enabled])
}

/// One patient's journey through one automation, anchored to ONE triggering entity.
/// Three clinic visits are three runs; conditions read the run's own subject, so
/// "diagnostics for THIS visit" cannot silently become "diagnostics ever".
model AutomationRun {
  id           String @id @default(cuid())
  automationId String
  /// Copied at enrolment. The run keeps its rules even when the automation is edited.
  version      Int
  subjectType  String // PATIENT | VISIT | TEST_ORDER | REPORT_VERSION | COUPON
  subjectId    String
  /// Re-entry, idempotency and dedup in one string: visitId | '2026-09' | 'once'.
  cycleKey     String
  /// PINNED at enrolment. Never re-derived from a phone number — that is the live
  /// misattribution bug in webhooks.ts:345, and this column is how it stops.
  patientId    String?
  branchId     String?
  /// FROZEN copy of Automation.definition.
  definition   Json
  stepIndex    Int      @default(0)
  state        String   @default("PENDING") // PENDING | RUNNING | DONE | STOPPED | FAILED
  stopReason   String?
  /// hash(automationId + patientId) — keyed on the PATIENT, never the subject, or the same
  /// person lands in different arms on different visits and both are contaminated.
  holdout      Boolean  @default(false)
  attempts     Int      @default(0)
  /// The instant the trigger fired. Every anchored wait and the conversion window are
  /// measured from HERE, never from the send — the held-back arm has no send to measure from.
  triggeredAt           DateTime
  nextActionAt          DateTime?
  /// Set when the goal is met. A claim the reconciliation sweep can revoke: visit completion
  /// is not monotonic here (reopenVisitForEntry) and orders get refunded.
  convertedAt           DateTime?
  convertedBranchId     String?
  convertedValueInPaise Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  automation Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  steps      AutomationStepLog[]

  /// The whole re-entry section, as one index.
  @@unique([automationId, subjectId, cycleKey])
  /// The ticker's only query.
  @@index([state, nextActionAt])
  @@index([automationId, state])
  @@index([patientId])
  @@index([convertedAt])
}

/// Append-only. This IS the Activity screen and the "why was she not messaged" answer —
/// nothing is reconstructed at read time, including the steps that chose to do nothing.
model AutomationStepLog {
  id        String @id @default(cuid())
  runId     String
  stepIndex Int
  kind      String // ENROLLED | WAIT | CHECK | SEND | SUPPRESSED | DEFERRED | COUPON | HANDOFF | STOPPED | REVERSED | FAILED
  /// The reason code. Always present, never null — an empty outcome is a bug.
  outcome      String
  /// The VALUES read at the moment of the decision, so "why" survives a later data change.
  detail       Json?
  messageLogId String?
  at           DateTime @default(now())

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, at])
  @@index([at])
}

/// At most one automation may hold a phone line at a time. The single-column primary key
/// IS the feature: correlation without heuristics, and a second automation wanting the line
/// is refused by the database rather than by a convention.
model AwaitingReply {
  phone           String @id // normalized "919876543210"
  automationRunId String @unique
  /// PINNED when the question was asked, so the reply is attributed to whoever was actually
  /// asked — not to whoever the newest outbound message happened to name.
  patientId String
  expiresAt DateTime
  /// { buttons: { "<payload>": stepIndex }, keywords: [{ match, stepIndex }] }
  match     Json
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// STOP is per NUMBER, not per patient. PatientIdentifier documents that families share a
/// handset, so a per-patient column cannot express "this phone said stop".
/// Opt-OUT is broad, opt-IN is narrow — asymmetric on purpose, and safe in both directions.
model PhoneOptOut {
  phone      String   @id // normalized "919876543210"
  optedOutAt DateTime @default(now())
  source     String // INBOUND_STOP | STAFF | IMPORT
  byUserId   String? // staff-initiated only
  reason     String?
}

// ============================================================================
// VOICE RX — structured prescriptions
//
// The portal's FIRST structured prescription. Before this, a "prescription" was
// a blank Rx sheet printed on letterhead (ClinicPrescriptionPrint in `rx` mode),
// which stays working untouched: a visit with no Prescription row still prints
// the blank sheet, exactly as every visit did before today.
//
// Design rules encoded here, each from a specific finding:
//   - A signed prescription is IMMUTABLE and renders from a frozen snapshot, not
//     live config. Reports learned this with the per-branch footer; a doctor
//     editing their qualification must not rewrite a document they already signed.
//   - Provenance is per FIELD, not per prescription. 54-86% of ambient-scribe
//     errors are omissions, which nothing on a page prompts you to notice, so
//     "the doctor did not say a timing" has to be a stored value, not an absence.
//   - The LLM never decides what a drug IS. It reports spoken text; Medication
//     resolves it; ambiguity asks the doctor.
// ============================================================================

enum PrescriptionStatus {
  /// Created, editable. Voice-drafted or typed — no distinction is drawn, because
  /// the doctor's obligation to review is identical either way.
  DRAFT
  /// Signed. Immutable. Renders from `snapshot` forever.
  SIGNED
  /// A later revision replaced this one. Kept, never deleted.
  SUPERSEDED
}

/// How a spoken/typed medicine name was matched against the Medication table.
enum MedicationResolution {
  /// Exactly one confident match. Safe to print.
  RESOLVED
  /// Several plausible matches — the doctor MUST pick. Blocks signing.
  AMBIGUOUS
  /// No match. The doctor may still prescribe it as free text (they are the
  /// authority, not our catalog), but it is flagged and blocks signing until
  /// acknowledged.
  UNRESOLVED
  /// The doctor typed or corrected this themselves. Highest trust — never
  /// re-resolved, never second-guessed.
  MANUAL
}

/// Medication catalog. Deliberately NOT sourced from the LLM: this is the layer
/// that decides what "Augmentin 625" means, and it must be inspectable and
/// correctable by a human.
model Medication {
  id            String  @id @default(cuid())
  canonicalName String // what prints, e.g. "Amoxicillin 500 mg + Clavulanic acid 125 mg"
  genericName   String?
  brandName     String?
  manufacturer  String?
  strength      String? // "500+125"
  strengthUnit  String? // "mg"
  dosageForm    String? // tablet | capsule | syrup | injection | drops | ointment
  route         String? // oral | topical | IV | IM | ...

  /// Spoken and written variants that should match this row: brand spellings,
  /// clinic shorthand ("amoxiclav", "augmentin"), and known ASR mishearings.
  /// Every doctor correction is a candidate for this list.
  aliases       String[] @default([])
  /// Double-metaphone-ish key for sound-alike matching. Populated at seed time.
  phoneticKey   String?
  /// Lowercased, punctuation-stripped concatenation of every name this row can
  /// be found by. Indexed with pg_trgm so fuzzy search is an indexed operation
  /// in Postgres rather than a full scan in Node — the difference between a
  /// 41-row seed and a 250,000-row catalogue on a 512MB instance.
  searchText    String?

  /// Telemedicine Practice Guidelines §3.7.4 prohibits prescribing Schedule X
  /// drugs and NDPS narcotics/psychotropics over telemedicine, absolutely, with
  /// no exception found in any source. The validator treats these as an
  /// UN-OVERRIDABLE block, not a dismissible warning — published CDS alert
  /// override rates run 49-96%, so a warning here would be noise, not a control.
  isScheduleX   Boolean @default(false)
  isNdps        Boolean @default(false)
  /// Schedule H/H1 drive pharmacist record-keeping, not a prescribing block.
  scheduleClass String? // H | H1 | X | OTC | null

  /// CURATED (hand-written, carries clinic shorthand and ASR mishearings) ·
  /// IMPORTED (bulk catalogue) · LEARNED (a doctor wrote it here; unverified).
  source          String    @default("IMPORTED")
  /// How often it has been prescribed HERE. Ranks the clinic's own vocabulary
  /// above the long tail — the point of a 250k catalogue and a 40-drug reality.
  usageCount      Int       @default(0)
  lastUsedAt      DateTime?
  learnedByUserId String?

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  learnedBy User?              @relation("MedicationLearnedBy", fields: [learnedByUserId], references: [id], onDelete: SetNull)
  items     PrescriptionItem[]

  @@index([canonicalName])
  @@index([genericName])
  @@index([brandName])
  @@index([phoneticKey])
  @@index([isActive, deletedAt])
  @@index([source])
  @@index([usageCount, lastUsedAt])
}

model Prescription {
  id             String             @id @default(cuid())
  visitId        String
  clinicDoctorId String
  branchId       String

  /// Revision chain. `rootId` groups every version of one prescription; the first
  /// version's rootId is its own id. The patient link resolves rootId -> isLatest
  /// SIGNED, never a pinned version — reports already learned that a token pinned
  /// to one version keeps serving a superseded document.
  rootId            String
  version           Int     @default(1)
  isLatest          Boolean @default(true)
  previousVersionId String?
  revisionReason    String? // required when superseding a SIGNED prescription

  status PrescriptionStatus @default(DRAFT)

  /// Clinical content the doctor typed/spoke. Free text by design: we have no
  /// ICD/SNOMED anywhere in this database and inventing a coding layer to hold
  /// one string would be the wrong trade.
  diagnosis    String?
  notes        String?
  followUpDays Int?

  // --- signature -----------------------------------------------------------
  signedAt       DateTime?
  /// Last time staff printed it (Print turns green, like the bill and report).
  printedAt      DateTime?
  signedByUserId String?
  /// EVERYTHING the signed sheet renders from: doctor name, qualification,
  /// registration number, signature image, branch letterhead, patient identity
  /// at that moment. Immutability is a frozen payload, not a status column.
  snapshot       Json?

  // --- voice provenance ----------------------------------------------------
  /// Null for a typed prescription. Voice is an accelerator; the typed path is
  /// the product, and every failure mode falls back to it.
  transcript         String?
  /// [{ text, start, end }] — per-segment timings, so a field can point at the
  /// seconds of speech that produced it. Without this, "view source" is theatre:
  /// in production generative systems only ~74.5% of citations actually support
  /// the claim they are attached to, and an uncheckable citation raises
  /// acceptance without raising accuracy.
  transcriptSegments Json?
  asrProvider        String? // groq | sarvam
  asrModel           String?
  asrLanguage        String?
  extractionModel    String?
  /// R2 object key. Audio is NOT kept forever: retention is configurable and the
  /// key is cleared when the object is deleted.
  audioKey           String?
  audioDurationSec   Float?
  audioDeletedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  visit        Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  clinicDoctor ClinicDoctor       @relation(fields: [clinicDoctorId], references: [id], onDelete: Restrict)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  signedBy     User?              @relation("PrescriptionSignedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)
  items        PrescriptionItem[]
  tokens       PrescriptionAccessToken[]

  @@index([visitId])
  @@index([clinicDoctorId])
  @@index([branchId])
  @@index([rootId, isLatest])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String
  displayOrder   Int    @default(0)

  /// What the doctor actually said, preserved verbatim even after normalisation.
  /// "spoken as Augmentin 625" survives onto the printed sheet so a later reader
  /// can tell dictation from normalisation.
  spokenText String?

  medicationId  String?
  canonicalName String // what prints — free text if unresolved; the doctor is the authority
  genericName   String?
  brandName     String?
  strength      String?
  strengthUnit  String?
  dosageForm    String?

  doseQty       String?
  doseUnit      String?
  frequencyCode String? // OD | BD | TID | QID | HS | SOS | STAT | WEEKLY | ALT_DAY
  frequencyText String? // what prints, e.g. "three times a day"
  doseSchedule  String? // morning-afternoon-night as the pad writes it: "1-0-1", "½-0-1"
  route         String?
  timing        String? // before food | after food | with food | bedtime | empty stomach
  durationValue Int?
  durationUnit  String? // days | weeks | months
  instructions  String?

  resolution MedicationResolution @default(MANUAL)
  /// Candidate matches when AMBIGUOUS: [{ medicationId, canonicalName, score }].
  /// Rendered stacked and spelt out in full, never truncated and never
  /// pre-selected — 18 of 23 prescribers in one study reported having picked the
  /// entry next to the one they meant.
  candidates Json?

  /// Per-field provenance: { timing: "UNKNOWN", frequency: "SPOKEN", route: "NORMALIZED" }.
  /// The whole point of PART 6: explicitly spoken, normalised, and unknown must
  /// stay distinguishable. "not stated" is a VALUE, never a silent default.
  fieldStates Json?

  /// Where in the audio this came from. Nullable for typed items.
  sourceText  String?
  sourceStart Float?
  sourceEnd   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication?  @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@index([medicationId])
}

/// Public patient link for a signed prescription. Mirrors BillAccessToken exactly.
/// Anchored on rootId, NOT on a version, so the link follows the latest signed
/// revision instead of serving a superseded document.
model PrescriptionAccessToken {
  id             String    @id @default(cuid())
  token          String    @unique // SHA-256 of the raw bearer token
  prescriptionId String // the ROOT prescription id
  expiresAt      DateTime?
  revokedAt      DateTime?
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  lastAccessedIp String?
  createdAt      DateTime  @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([expiresAt])
}
