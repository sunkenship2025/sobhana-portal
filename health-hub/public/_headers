# Cloudflare Pages equivalent of vercel.json "headers". Vite fingerprints
# everything in /assets/ with a content hash, so a given URL's bytes never change
# — safe to cache for a year and never revalidate. index.html is deliberately NOT
# listed: it must stay uncached so a deploy is picked up immediately (the display
# TVs self-reload by polling index.html for changed asset URLs).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
